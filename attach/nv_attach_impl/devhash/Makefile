# The device hash map's GPU functions as PTX text (plan results
# gpu/hash-build-plan-20261127, S3). Both outputs are checked in, as
# ../trampoline_ptx.h is; regenerate them after changing devhash.cu,
# devhash_harness.cu or ../trampoline/gpu_devhash_layout.h:
#   make -C attach/nv_attach_impl/devhash
#
# ../devhash_ptx.h   DEVHASH_PTX: the three functions only, without the
#                    module header and with .visible dropped (the routing
#                    pass puts them at the start of a patched module's body)
# ../devhash_test_ptx.h  whole modules of the test kernels
#                    (devhash_harness.cu) with one build each: the test build,
#                    controls 1, 2, 5 and 6, wait bound 0, and the shipped
#                    build (no outcome channel)
CLANG ?= clang++-16
ARCH ?= sm_70
DEVICE_ONLY_FLAGS ?= -x cuda --cuda-device-only -nocudainc -nocudalib
CFLAGS = $(DEVICE_ONLY_FLAGS) --cuda-gpu-arch=$(ARCH) -O2 -S -Wno-unknown-cuda-version
DEPS = devhash.cu ../trampoline/gpu_devhash_layout.h Makefile
TEST = -DBPFTIME_DEVHASH_TEST
# name:flags, the flags joined with +
VARIANTS = TEST:$(TEST) FAULT1:$(TEST)+-DBPFTIME_DEVHASH_FAULT=1 \
	FAULT2:$(TEST)+-DBPFTIME_DEVHASH_FAULT=2 \
	FAULT5:$(TEST)+-DBPFTIME_DEVHASH_FAULT=5 \
	FAULT6:$(TEST)+-DBPFTIME_DEVHASH_FAULT=6 \
	WAIT0:$(TEST)+-DBPFTIME_DEVHASH_WAIT_BOUND=0 \
	SHIPPED: SHIPPEDFAULT6:-DBPFTIME_DEVHASH_FAULT=6

.PHONY: all clean
all: ../devhash_ptx.h ../devhash_test_ptx.h

../devhash_ptx.h: $(DEPS)
	$(CLANG) $(CFLAGS) devhash.cu -o devhash.ptx
	@{ echo '// Generated by attach/nv_attach_impl/devhash/Makefile from devhash.cu; do not edit.'; \
	   echo 'static const char DEVHASH_PTX[] = R"PTX('; \
	   sed -e '/^\.version/d' -e '/^\.target/d' -e '/^\.address_size/d' \
	       -e 's/^\.visible \.func/.func/' devhash.ptx; \
	   echo ')PTX";'; } > $@
	@echo "Generated $@"

../devhash_test_ptx.h: $(DEPS) devhash_harness.cu
	@echo '// Generated by attach/nv_attach_impl/devhash/Makefile; do not edit.' > $@.tmp
	@for v in $(VARIANTS); do \
		name=$${v%%:*}; flags=$$(echo $${v#*:} | tr '+' ' '); \
		$(CLANG) $(CFLAGS) $$flags devhash_harness.cu -o harness-$$name.ptx || exit 1; \
		echo "static const char DEVHASH_TEST_PTX_$$name[] = R\"PTX(" >> $@.tmp; \
		cat harness-$$name.ptx >> $@.tmp; \
		echo ')PTX";' >> $@.tmp; \
	done
	@mv $@.tmp $@
	@echo "Generated $@"

clean:
	rm -f devhash.ptx harness-*.ptx
