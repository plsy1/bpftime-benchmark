diff --git a/runtime/unit-test/maps/test_fix_hash_map.cpp b/runtime/unit-test/maps/test_fix_hash_map.cpp
index bd6a0e8..13875cc 100644
--- a/runtime/unit-test/maps/test_fix_hash_map.cpp
+++ b/runtime/unit-test/maps/test_fix_hash_map.cpp
@@ -199,3 +199,73 @@ TEST_CASE("Fixed hash iteration scans adjusted bucket count",
