+			{0,0,0,0,0}, {0x85,0,0,0,1}, {0x95,0,0,0,0},
+		};
+		bpftime_prog prog(code,5,"array_jit_interpreter_fallback");
+		REQUIRE(prog.request_array_map_inlining() == 0);
