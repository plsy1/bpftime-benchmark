index 62b098d9..9e66d3bb 100644
--- a/runtime/src/bpf_map/map_common_def.hpp
+++ b/runtime/src/bpf_map/map_common_def.hpp
@@ -15,11 +15,28 @@
 #include <utility>
 #include <cstring>
 #include <vector>
+#include <pthread.h>
 #include "platform_utils.hpp"
 
 namespace bpftime
 {
 
+// Experiment: inline spinlock on the pthread_spinlock_t word (glibc's
+// protocol: 0 free, exchange 1 to take, release store 0 to give back).
+static inline void exp_spin_lock(volatile pthread_spinlock_t *l)
+{
+	// pthread_spinlock_t is volatile int in glibc.
+	int *w = (int *)l;
+	while (__atomic_exchange_n(w, 1, __ATOMIC_ACQUIRE) != 0) {
+		while (__atomic_load_n(w, __ATOMIC_RELAXED) != 0)
+			__asm__ __volatile__("yield");
+	}
+}
+static inline void exp_spin_unlock(volatile pthread_spinlock_t *l)
+{
+	__atomic_store_n((int *)l, 0, __ATOMIC_RELEASE);
+}
+
 using bytes_vec_allocator = boost::interprocess::allocator<
 	uint8_t, boost::interprocess::managed_shared_memory::segment_manager>;
 using bytes_vec = boost::interprocess::vector<uint8_t, bytes_vec_allocator>;
