 		.bpf_map_lookup_elem((int)map, (void *)key, false);
 }
 
+uint64_t bpftime_percpu_array_map_lookup_elem_helper(
+	uint64_t map, uint64_t key, uint64_t, uint64_t, uint64_t)
+{
+	auto &shm = bpftime::shm_holder.global_shared_memory;
+	const int fd = static_cast<int>(map);
+	if (!shm.is_map_fd(fd)) {
+		errno = ENOENT;
+		return 0;
+	}
+	const auto &handler =
+		std::get<bpftime::bpf_map_handler>(shm.get_handler(fd));
+	return reinterpret_cast<uint64_t>(
+		handler.map_lookup_percpu_array(reinterpret_cast<void *>(key)));
+}
