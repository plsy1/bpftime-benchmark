+// DIAG (not for commit): where a child crashes.
+std::atomic<int> diag_cycle{ -1 };
+std::atomic<int> diag_step{ 0 };
+pid_t diag_main_tid = 0;
+void diag_handler(int sig, siginfo_t *si, void *ucv)
+{
+	auto *uc = (ucontext_t *)ucv;
+	const uint32_t *code = (const uint32_t *)(void *)detach_while_called_target;
+	char buf[768];
+	int n = snprintf(
+		buf, sizeof buf,
+		"DIAG sig=%d code=%d tid=%d main=%d cycle=%d step=%d pc=%llx "
+		"lr=%llx sp=%llx x16=%llx x17=%llx x0=%llx x1=%llx x3=%llx "
+		"fault=%llx si_addr=%p fn=%p fnwords=%08x %08x %08x %08x "
+		"pc_minus_fn=%lld\n",
+		sig, si->si_code, (int)gettid(), (int)diag_main_tid,
+		diag_cycle.load(), diag_step.load(),
+		(unsigned long long)uc->uc_mcontext.pc,
+		(unsigned long long)uc->uc_mcontext.regs[30],
+		(unsigned long long)uc->uc_mcontext.sp,
+		(unsigned long long)uc->uc_mcontext.regs[16],
+		(unsigned long long)uc->uc_mcontext.regs[17],
+		(unsigned long long)uc->uc_mcontext.regs[0],
+		(unsigned long long)uc->uc_mcontext.regs[1],
+		(unsigned long long)uc->uc_mcontext.regs[3],
+		(unsigned long long)uc->uc_mcontext.fault_address, si->si_addr,
+		(void *)code, code[0], code[1], code[2], code[3],
+		(long long)(uc->uc_mcontext.pc - (uintptr_t)code));
+	if (n > 0)
+		(void)!write(2, buf, n);
+	_exit(128 + sig);
+}
+void diag_install()
+{
+	diag_main_tid = gettid();
+	if (getenv("BPFTIME_DIAG_SIGNALS") == nullptr)
+		return;
+	struct sigaction sa = {};
+	sa.sa_sigaction = diag_handler;
+	sa.sa_flags = SA_SIGINFO;
+	sigemptyset(&sa.sa_mask);
+	for (int sig : { SIGSEGV, SIGBUS, SIGILL, SIGTRAP, SIGFPE, SIGABRT })
+		sigaction(sig, &sa, nullptr);
+}
