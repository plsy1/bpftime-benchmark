+// Hooked only in fork children: each child's hook is its first.
+extern "C" __attribute__((noinline)) uint64_t
+attach_window_target(uint64_t x)
+{
+	uint64_t h = 0xd6e8feb86659fd93ULL;
+	for (int i = 0; i < 4; i++) {
+		h ^= x + i;
+		h *= 0xbf58476d1ce4e5b9ULL;
+	}
+	asm volatile("" : "+r"(h));
+	return h;
+}
