+TEST_CASE("Four-byte fixed hash uses multiplicative integer hashing",
+	  "[maps][hash][hash-fast4]")
+{
+	const std::array<std::array<uint8_t, 4>, 5> cases = { {
+		{ 0x00, 0x00, 0x00, 0x00 },
+		{ 0x01, 0x00, 0x00, 0x00 },
+		{ 0xff, 0xff, 0xff, 0xff },
+		{ 0x12, 0x34, 0x56, 0x78 },
+		{ 0x78, 0x56, 0x34, 0x12 },
+	} };
+
+	for (const auto &bytes : cases) {
+		uint32_t value;
+		std::memcpy(&value, bytes.data(), sizeof(value));
+		const size_t expected =
+			size_t{ value } * size_t{ 0x9e3779b1U };
+		REQUIRE(bpftime_hasher::hash_func(bytes.data(), bytes.size()) ==
+			expected);
+	}
+}
