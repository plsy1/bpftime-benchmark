+static __inline void goroutine_update(__u64 key, __u64 value)
+{
+	__u32 start = df_tbl_hash(key);
+	struct goroutine_slot *spare = NULL;
+	for (__u32 j = 0; j < DF_TBL_PROBES; j++) {
+		__u32 i = (start + j) % DF_TBL_SLOTS;
