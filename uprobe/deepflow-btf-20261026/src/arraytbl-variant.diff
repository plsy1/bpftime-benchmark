+/*
+ * Experiment (bpftime benchmark): proc_info_map is a linear-probing table in
+ * the array map "proc_info_tbl" (see kernel/uprobe_base.bpf.c); a slot is
+ * free (0), used (1) or deleted (2).
+ */
+#define DF_TBL_SLOTS 229
+#define DF_TBL_PROBES 16
+struct proc_info_slot {
+	uint32_t state;
+	uint32_t key;
+	struct ebpf_proc_info value;
+};
+
+static uint32_t df_tbl_hash(uint64_t key)
+{
+	return (uint32_t)((key * 0x9E3779B97F4A7C15ULL) >> 32) % DF_TBL_SLOTS;
+}
+
+static bool proc_info_tbl_set(struct bpf_tracer *tracer, int pid,
+			      struct ebpf_proc_info *info)
+{
+	int fd = bpf_table_get_fd(tracer, "proc_info_tbl");
+	if (fd < 0)
+		return false;
+	uint32_t start = df_tbl_hash((uint32_t)pid);
+	int target = -1;
+	for (uint32_t j = 0; j < DF_TBL_PROBES; j++) {
+		uint32_t i = (start + j) % DF_TBL_SLOTS;
+		struct proc_info_slot slot;
+		if (bpf_lookup_elem(fd, &i, &slot) != 0)
+			return false;
+		if (slot.state == 1 && slot.key == (uint32_t)pid) {
+			target = i;
+			break;
+		}
+		if (slot.state != 1 && target < 0)
+			target = i;
+		if (slot.state == 0)
+			break;
+	}
+	if (target < 0)
+		return false;
+	struct proc_info_slot slot = { .state = 1, .key = (uint32_t)pid,
+				       .value = *info };
+	uint32_t k = target;
+	return bpf_update_elem(fd, &k, &slot, BPF_ANY) == 0;
+}
