+/*
+ * Experiment (bpftime benchmark, after eunomia-bpf/deepflow's "mocked
+ * hashmap"): proc_info_map and goroutines_map are hash tables kept in
+ * BPF_MAP_TYPE_ARRAY maps, linear probing over DF_TBL_SLOTS slots. A slot is
+ * free (0), used (1) or deleted (2); lookups stop at a free slot or after
+ * DF_TBL_PROBES slots (eunomia scanned all 229; a full scan made the 5.2+
+ * programs too complex for the verifier and, unrolled in the "common" build,
+ * longer than bpftime_daemon can capture). Writes go through the pointer
+ * bpf_map_lookup_elem returns. No locking (as eunomia).
+ */
+#define DF_TBL_SLOTS 229
+#define DF_TBL_PROBES 16
+#define DF_SLOT_FREE 0
+#define DF_SLOT_USED 1
+#define DF_SLOT_DELETED 2
+
+static __inline __u32 df_tbl_hash(__u64 key)
+{
+	return (__u32)((key * 0x9E3779B97F4A7C15ULL) >> 32) % DF_TBL_SLOTS;
+}
+
+struct proc_info_slot {
+	__u32 state;
+	__u32 key;
+	struct ebpf_proc_info value;
+};
+
+struct bpf_map_def SEC("maps") proc_info_tbl = {
+	.type = BPF_MAP_TYPE_ARRAY,
+	.key_size = sizeof(__u32),
+	.value_size = sizeof(struct proc_info_slot),
+	.max_entries = DF_TBL_SLOTS,
 	.feat_flags = FEATURE_FLAG_UPROBE_GOLANG,
 };
 
+static __inline struct proc_info_slot *proc_info_find(__u32 key)
+{
+	__u32 start = df_tbl_hash(key);
+	for (__u32 j = 0; j < DF_TBL_PROBES; j++) {
+		__u32 i = (start + j) % DF_TBL_SLOTS;
+		struct proc_info_slot *e = bpf_map_lookup_elem(&proc_info_tbl, &i);
+		if (!e || e->state == DF_SLOT_FREE)
+			return NULL;
+		if (e->state == DF_SLOT_USED && e->key == key)
+			return e;
+	}
+	return NULL;
+}
+
+static __inline struct ebpf_proc_info *proc_info_lookup(__u32 key)
+{
+	struct proc_info_slot *e = proc_info_find(key);
+	return e ? &e->value : NULL;
+}
+
+static __inline void proc_info_delete(__u32 key)
+{
+	struct proc_info_slot *e = proc_info_find(key);
+	if (e)
+		e->state = DF_SLOT_DELETED;
+}
+
+#define PROC_INFO_LOOKUP(kp) proc_info_lookup(*(kp))
+#define PROC_INFO_DELETE(kp) proc_info_delete(*(kp))
