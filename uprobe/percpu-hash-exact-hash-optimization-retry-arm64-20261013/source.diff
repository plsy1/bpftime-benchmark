+		{ 0x12, 0x34, 0x56, 0x78 },
+		{ 0x78, 0x56, 0x34, 0x12 },
+	} };
+
+	for (const auto &bytes : cases) {
+		std::copy(bytes.begin(), bytes.end(), key.begin());
+		size_t legacy_hash = 0;
+		boost::hash_combine(legacy_hash, key.size());
+		for (uint8_t byte : key)
+			boost::hash_combine(legacy_hash, byte);
+		REQUIRE(bytes_vec_hasher{}(key) == legacy_hash);
+	}
