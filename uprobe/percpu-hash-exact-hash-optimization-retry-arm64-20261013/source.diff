diff --git a/runtime/src/bpf_map/map_common_def.hpp b/runtime/src/bpf_map/map_common_def.hpp
index b0d6ace..8b24428 100644
--- a/runtime/src/bpf_map/map_common_def.hpp
+++ b/runtime/src/bpf_map/map_common_def.hpp
@@ -73,6 +73,16 @@ struct bytes_vec_hasher {
 		using boost::hash_combine;
 		size_t seed = 0;
 		hash_combine(seed, size);
+		if (size == sizeof(uint32_t)) {
+			// Four-byte keys are the common BPF map case. Spell out the
+			// combines so the compiler does not need a counted byte loop,
+			// while preserving the existing hash value exactly.
+			hash_combine(seed, data[0]);
+			hash_combine(seed, data[1]);
+			hash_combine(seed, data[2]);
+			hash_combine(seed, data[3]);
+			return seed;
+		}
 		for (size_t i = 0; i < size; ++i)
 			hash_combine(seed, data[i]);
 		return seed;
