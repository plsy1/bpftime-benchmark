+	{ "system", &real_system, (void *)bpftime_careful_system_hook, false },
+	{ "popen", &real_popen, (void *)bpftime_careful_popen_hook, false },
+	{ "_IO_popen", &real_popen, (void *)bpftime_careful_popen_hook, true },
+#if CAREFUL_HAVE_VFORK
+	{ "vfork", &bpftime_careful_real_vfork,
+	  (void *)bpftime_careful_vfork_hook, false },
+	{ "__vfork", &bpftime_careful_real_vfork,
+	  (void *)bpftime_careful_vfork_hook, true },
