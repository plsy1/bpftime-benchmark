diff --git a/runtime/agent/careful_hooks.c b/runtime/agent/careful_hooks.c
new file mode 100644
index 00000000..69e5f856
--- /dev/null
+++ b/runtime/agent/careful_hooks.c
@@ -0,0 +1,481 @@
+/* SPDX-License-Identifier: MIT */
+// Dnext careful mode (BPFTIME_CAREFUL=1; see runtime/src/producer_identity.hpp).
+// The agent interposes the libc calls after which a per-thread cache would be
+// stale:
+//  - identity (pid, tid): vfork/__vfork, _Fork, clone/__clone, posix_spawn,
+//    posix_spawnp, pidfd_spawn, pidfd_spawnp, system, popen/_IO_popen. Each
+//    bumps bpftime_identity_epoch before the real call, so every thread checks
+//    its cached identity again. A child that shares this process's memory
+//    (vfork, CLONE_VM) then sees a pid other than the process's and caches
+//    nothing; the parent reads its own identity once. While a thread spawns a
+//    child that shares its TLS (posix_spawn & co., CLONE_VFORK clones), it
+//    caches nothing (bpftime_careful_spawning), so a signal handler or probe
+//    between the bump and the clone cannot hand the parent's identity to the
+//    child. A clone with CLONE_VM but no CLONE_SETTLS that runs concurrently
+//    with its parent (no CLONE_VFORK, or CLONE_THREAD) shares the caller's TLS:
+//    that TLS block caches nothing from then on. The children of a raw _Fork
+//    and of a clone without CLONE_VM run no fork handlers: they reset the
+//    identity state themselves (the clone child through a trampoline). fork()
+//    calls _Fork internally, not through the PLT, and keeps using the fork
+//    handlers.
+//  - comm: prctl(PR_SET_NAME) and pthread_setname_np. glibc's
+//    pthread_setname_np calls prctl directly (self) or writes
+//    /proc/self/task/<tid>/comm (another thread), so it is interposed itself.
+//  - credentials: a vfork-like child or a CLONE_VM clone that may change its
+//    credentials while sharing the process-wide credential cache turns the
+//    cache off for good (credential_hooks.cpp, the clone interposer).
+// With the switch off every interposer only forwards to libc. In careful mode
+// the caches are used only if the process binds every interposer (the agent
+// was LD_PRELOADed); otherwise identity and comm are read on every call.
+// Not observed: raw system calls (including syscall(2)), writes to
+// /proc/.../comm. Known off-mode difference: posix_spawn/posix_spawnp have
+// GLIBC_2.2.5 compat versions (shell fallback on ENOEXEC); the agent's
+// unversioned definitions also capture references to them and forward to the
+// default version, so binaries linked against glibc < 2.15 lose that fallback.
+//
+// C, not C++: libstdc++'s <atomic> pulls in <unistd.h> and <pthread.h>, whose
+// noexcept prototypes a C++ alias declaration would have to repeat exactly.
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include <dlfcn.h>
+#include <errno.h>
+#include <pthread.h>
+#include <sched.h>
+#include <spawn.h>
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/prctl.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+extern bool bpftime_careful_mode;
+extern uint64_t bpftime_identity_epoch;
+extern __thread unsigned bpftime_careful_spawning;
+void bpftime_identity_bump_epoch(void);
+void bpftime_identity_after_raw_fork_child(void);
+void bpftime_identity_mark_tls_shared(void);
+void bpftime_identity_disable_pid_namespace_cache(void);
+void bpftime_identity_disable_cache(void);
+void bpftime_identity_enable_cache(void);
+void bpftime_careful_comm_set_cache_enabled(bool enabled);
+void bpftime_careful_comm_rename_begin(void);
+void bpftime_careful_comm_rename_end(void);
+void bpftime_set_credential_cache_enabled(bool enabled);
+
+#define HIDDEN __attribute__((visibility("hidden")))
+#define EXPORT_ALIAS(target)                                                   \
+	__attribute__((visibility("default"), alias(target)))
+
+static inline bool careful(void)
+{
+	return __builtin_expect(bpftime_careful_mode, 0);
+}
+
+// Real libc functions, resolved by the constructor below (and again, lazily,
+// if an interposer runs before it) with dlsym(RTLD_NEXT).
+static void *careful_real(void **slot, const char *name)
+{
+	void *fn = __atomic_load_n(slot, __ATOMIC_ACQUIRE);
+	if (!fn) {
+		fn = dlsym(RTLD_NEXT, name);
+		__atomic_store_n(slot, fn, __ATOMIC_RELEASE);
+	}
+	return fn;
+}
+
+static void *real_prctl, *real_pthread_setname_np, *real__Fork, *real_clone,
+	*real_posix_spawn, *real_posix_spawnp, *real_pidfd_spawn,
+	*real_pidfd_spawnp, *real_system, *real_popen;
+// Read by the vfork stub below; `used`: LTO does not see asm references.
+HIDDEN __attribute__((used)) void *bpftime_careful_real_vfork;
+
+// Around a spawn whose child shares this thread's TLS until it execs.
+static inline void spawn_begin(void)
+{
+	bpftime_careful_spawning++;
+	__atomic_signal_fence(__ATOMIC_SEQ_CST);
+	bpftime_identity_bump_epoch();
+}
+
+static inline void spawn_end(void)
+{
+	__atomic_signal_fence(__ATOMIC_SEQ_CST);
+	bpftime_careful_spawning--;
+}
+
+HIDDEN int bpftime_careful_prctl_hook(int option, ...)
+{
+	va_list ap;
+	va_start(ap, option);
+	unsigned long a2 = va_arg(ap, unsigned long);
+	unsigned long a3 = va_arg(ap, unsigned long);
+	unsigned long a4 = va_arg(ap, unsigned long);
+	unsigned long a5 = va_arg(ap, unsigned long);
+	va_end(ap);
+	int (*fn)(int, unsigned long, unsigned long, unsigned long,
+		  unsigned long) = careful_real(&real_prctl, "prctl");
+	if (!fn) {
+		errno = ENOSYS;
+		return -1;
+	}
+	if (!careful() || option != PR_SET_NAME)
+		return fn(option, a2, a3, a4, a5);
+	bpftime_careful_comm_rename_begin();
+	int ret = fn(option, a2, a3, a4, a5);
+	int saved = errno;
+	bpftime_careful_comm_rename_end();
+	errno = saved;
+	return ret;
+}
+
+HIDDEN int bpftime_careful_pthread_setname_np_hook(pthread_t thread,
+						   const char *name)
+{
+	int (*fn)(pthread_t, const char *) =
+		careful_real(&real_pthread_setname_np, "pthread_setname_np");
+	if (!fn)
+		return ENOSYS;
+	if (!careful())
+		return fn(thread, name);
+	// rename_end bumps the epoch: the renamed thread, this one or
+	// another, reads its name again.
+	bpftime_careful_comm_rename_begin();
+	int ret = fn(thread, name);
+	int saved = errno;
+	bpftime_careful_comm_rename_end();
+	errno = saved;
+	return ret;
+}
+
+HIDDEN pid_t bpftime_careful__Fork_hook(void)
+{
+	pid_t (*fn)(void) = careful_real(&real__Fork, "_Fork");
+	if (!fn) {
+		errno = ENOSYS;
+		return -1;
+	}
+	if (!careful())
+		return fn();
+	bpftime_identity_bump_epoch();
+	pid_t ret = fn();
+	if (ret == 0) {
+		int saved = errno;
+		bpftime_identity_after_raw_fork_child();
+		errno = saved;
+	}
+	return ret;
+}
+
+// A clone without CLONE_VM: the child runs on a copy of this process's
+// memory, so it can read the trampoline arguments from the parent's frame.
+struct careful_clone_tramp {
+	int (*fn)(void *);
+	void *arg;
+};
+
+static int careful_clone_child(void *p)
+{
+	struct careful_clone_tramp t = *(struct careful_clone_tramp *)p;
+	bpftime_identity_after_raw_fork_child();
+	return t.fn(t.arg);
+}
+
+HIDDEN int bpftime_careful_clone_hook(int (*fn)(void *), void *stack,
+				      int flags, void *arg, ...)
+{
+	// glibc's clone reads ptid, tls and ctid as the 5th-7th arguments
+	// whatever the flags; pass them through the same way.
+	va_list ap;
+	va_start(ap, arg);
+	void *ptid = va_arg(ap, void *);
+	void *tls = va_arg(ap, void *);
+	void *ctid = va_arg(ap, void *);
+	va_end(ap);
+	int (*real)(int (*)(void *), void *, int, void *, ...) =
+		careful_real(&real_clone, "clone");
+	if (!real) {
+		errno = ENOSYS;
+		return -1;
+	}
+	if (!careful())
+		return real(fn, stack, flags, arg, ptid, tls, ctid);
+	bool vm = flags & CLONE_VM;
+	bool settls = flags & CLONE_SETTLS;
+	bool vfork = flags & CLONE_VFORK;
+	bool thread = flags & CLONE_THREAD;
+	if (!vm) {
+		// A separate process: its identity, namespace, shard and probe
+		// state are reset in the child itself. glibc rejects a NULL fn
+		// with EINVAL; keep that.
+		if (fn == NULL)
+			return real(fn, stack, flags, arg, ptid, tls, ctid);
+		bpftime_identity_bump_epoch();
+		struct careful_clone_tramp t = { fn, arg };
+		return real(careful_clone_child, stack, flags, &t, ptid, tls,
+			    ctid);
+	}
+	if (thread && settls)
+		return real(fn, stack, flags, arg, ptid, tls, ctid); // a thread
+	// CLONE_VM, sharing this thread's TLS (no SETTLS) or a new process
+	// sharing the memory (no THREAD).
+	if (flags & CLONE_NEWPID)
+		bpftime_identity_disable_pid_namespace_cache();
+	if (!thread)
+		// The child may change its credentials in the shared cache.
+		bpftime_set_credential_cache_enabled(false);
+	if (!settls && (!vfork || thread)) {
+		// Runs concurrently with this thread on the same TLS.
+		bpftime_identity_bump_epoch();
+		bpftime_identity_mark_tls_shared();
+		return real(fn, stack, flags, arg, ptid, tls, ctid);
+	}
+	if (vfork) {
+		// This thread waits until the child execs or exits.
+		spawn_begin();
+		int ret = real(fn, stack, flags, arg, ptid, tls, ctid);
+		int saved = errno;
+		spawn_end();
+		errno = saved;
+		return ret;
+	}
+	// CLONE_VM|CLONE_SETTLS without CLONE_THREAD: own TLS, shared memory.
+	bpftime_identity_bump_epoch();
+	return real(fn, stack, flags, arg, ptid, tls, ctid);
+}
+
+#define CAREFUL_SPAWN_HOOK(name, ptype)                                        \
+	HIDDEN int bpftime_careful_##name##_hook(                              \
+		ptype *restrict pid, const char *restrict path,                \
+		const posix_spawn_file_actions_t *restrict fa,                 \
+		const posix_spawnattr_t *restrict attr,                        \
+		char *const argv[restrict], char *const envp[restrict])        \
+	{                                                                      \
+		int (*fn)(ptype *, const char *,                               \
+			  const posix_spawn_file_actions_t *,                  \
+			  const posix_spawnattr_t *, char *const[],            \
+			  char *const[]) = careful_real(&real_##name, #name);  \
+		if (!fn)                                                       \
+			return ENOSYS;                                         \
+		if (!careful())                                                \
+			return fn(pid, path, fa, attr, argv, envp);            \
+		spawn_begin();                                                 \
+		int ret = fn(pid, path, fa, attr, argv, envp);                 \
+		spawn_end();                                                   \
+		return ret;                                                    \
+	}
+
+CAREFUL_SPAWN_HOOK(posix_spawn, pid_t)
+CAREFUL_SPAWN_HOOK(posix_spawnp, pid_t)
+CAREFUL_SPAWN_HOOK(pidfd_spawn, int)
+CAREFUL_SPAWN_HOOK(pidfd_spawnp, int)
+
+HIDDEN int bpftime_careful_system_hook(const char *command)
+{
+	int (*fn)(const char *) = careful_real(&real_system, "system");
+	if (!fn) {
+		errno = ENOSYS;
+		return -1;
+	}
+	if (!careful())
+		return fn(command);
+	spawn_begin();
+	int ret = fn(command);
+	int saved = errno;
+	spawn_end();
+	errno = saved;
+	return ret;
+}
+
+HIDDEN FILE *bpftime_careful_popen_hook(const char *command,
+					const char *modes)
+{
+	FILE *(*fn)(const char *, const char *) =
+		careful_real(&real_popen, "popen");
+	if (!fn) {
+		errno = ENOSYS;
+		return NULL;
+	}
+	if (!careful())
+		return fn(command, modes);
+	spawn_begin();
+	FILE *ret = fn(command, modes);
+	int saved = errno;
+	spawn_end();
+	errno = saved;
+	return ret;
+}
+
+int prctl(int option, ...) EXPORT_ALIAS("bpftime_careful_prctl_hook");
+int pthread_setname_np(pthread_t thread, const char *name)
+	EXPORT_ALIAS("bpftime_careful_pthread_setname_np_hook");
+pid_t _Fork(void) EXPORT_ALIAS("bpftime_careful__Fork_hook");
+int clone(int (*fn)(void *), void *stack, int flags, void *arg, ...)
+	EXPORT_ALIAS("bpftime_careful_clone_hook");
+int __clone(int (*fn)(void *), void *stack, int flags, void *arg, ...)
+	EXPORT_ALIAS("bpftime_careful_clone_hook");
+int posix_spawn(pid_t *restrict pid, const char *restrict path,
+		const posix_spawn_file_actions_t *restrict fa,
+		const posix_spawnattr_t *restrict attr,
+		char *const argv[restrict], char *const envp[restrict])
+	EXPORT_ALIAS("bpftime_careful_posix_spawn_hook");
+int posix_spawnp(pid_t *restrict pid, const char *restrict file,
+		 const posix_spawn_file_actions_t *restrict fa,
+		 const posix_spawnattr_t *restrict attr,
+		 char *const argv[restrict], char *const envp[restrict])
+	EXPORT_ALIAS("bpftime_careful_posix_spawnp_hook");
+int pidfd_spawn(int *restrict pidfd, const char *restrict path,
+		const posix_spawn_file_actions_t *restrict fa,
+		const posix_spawnattr_t *restrict attr,
+		char *const argv[restrict], char *const envp[restrict])
+	EXPORT_ALIAS("bpftime_careful_pidfd_spawn_hook");
+int pidfd_spawnp(int *restrict pidfd, const char *restrict file,
+		 const posix_spawn_file_actions_t *restrict fa,
+		 const posix_spawnattr_t *restrict attr,
+		 char *const argv[restrict], char *const envp[restrict])
+	EXPORT_ALIAS("bpftime_careful_pidfd_spawnp_hook");
+int system(const char *command) EXPORT_ALIAS("bpftime_careful_system_hook");
+FILE *popen(const char *command, const char *modes)
+	EXPORT_ALIAS("bpftime_careful_popen_hook");
+FILE *_IO_popen(const char *command, const char *modes)
+	EXPORT_ALIAS("bpftime_careful_popen_hook");
+
+// Resolves the real vfork for the stub when it runs before the constructor.
+HIDDEN void *bpftime_careful_resolve_vfork(void)
+{
+	return careful_real(&bpftime_careful_real_vfork, "vfork");
+}
+
+// vfork/__vfork: the child runs on the caller's stack until it execs or exits,
+// so the interposer must have no frame when it enters libc's vfork: it bumps
+// the epoch (careful mode) and jumps to libc's vfork, which returns to our
+// caller. Clobbers only rax and the flags, or, on the first call before the
+// constructor, the caller-saved registers of a call (vfork takes no
+// arguments). If libc's vfork cannot be found it jumps to fork, which POSIX
+// allows as a vfork implementation. bpftime_careful_vfork_hook is a hidden
+// name for the same address, for the binding check. A signal handler between
+// the bump and the vfork system call could still cache the parent's identity
+// for the child (a window of a few instructions; the C interposers close it
+// with bpftime_careful_spawning).
+#if defined(__x86_64__)
+__asm__(".text\n"
+	".globl vfork\n"
+	".type vfork, @function\n"
+	".globl __vfork\n"
+	".type __vfork, @function\n"
+	".globl bpftime_careful_vfork_hook\n"
+	".hidden bpftime_careful_vfork_hook\n"
+	".type bpftime_careful_vfork_hook, @function\n"
+	".p2align 4\n"
+	"vfork:\n"
+	"__vfork:\n"
+	"bpftime_careful_vfork_hook:\n"
+	"	endbr64\n"
+	"	movq bpftime_careful_mode@GOTPCREL(%rip), %rax\n"
+	"	cmpb $0, (%rax)\n"
+	"	je 1f\n"
+	"	movq bpftime_identity_epoch@GOTPCREL(%rip), %rax\n"
+	"	lock incq (%rax)\n"
+	"1:\n"
+	"	movq bpftime_careful_real_vfork(%rip), %rax\n"
+	"	testq %rax, %rax\n"
+	"	jz 2f\n"
+	"	jmp *%rax\n"
+	"2:\n"
+	"	subq $8, %rsp\n"
+	"	call bpftime_careful_resolve_vfork\n"
+	"	addq $8, %rsp\n"
+	"	testq %rax, %rax\n"
+	"	jz 3f\n"
+	"	jmp *%rax\n"
+	"3:\n"
+	"	jmp fork@PLT\n"
+	".size vfork, .-vfork\n"
+	".size __vfork, .-__vfork\n"
+	".size bpftime_careful_vfork_hook, .-bpftime_careful_vfork_hook\n");
+#define CAREFUL_HAVE_VFORK 1
+extern char bpftime_careful_vfork_hook[] HIDDEN;
+#else
+#define CAREFUL_HAVE_VFORK 0
+#endif
+
+struct careful_entry {
+	const char *name;
+	void **real;
+	void *hook;
+	bool optional; // may be missing from an older libc
+};
+
+static const struct careful_entry careful_entries[] = {
+	{ "prctl", &real_prctl, (void *)bpftime_careful_prctl_hook, false },
+	{ "pthread_setname_np", &real_pthread_setname_np,
+	  (void *)bpftime_careful_pthread_setname_np_hook, false },
+	{ "_Fork", &real__Fork, (void *)bpftime_careful__Fork_hook, true },
