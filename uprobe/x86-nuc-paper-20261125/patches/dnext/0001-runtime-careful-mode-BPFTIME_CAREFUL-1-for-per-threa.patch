+
+// Resolve every real function early, so that the interposers do not call
+// dlsym later (in a signal handler or a vfork child).
+__attribute__((constructor)) static void careful_resolve_all(void)
+{
+	for (size_t i = 0; i < sizeof(careful_entries) / sizeof(careful_entries[0]);
+	     i++) {
+		// __clone/__vfork/_IO_popen share the slot of clone/vfork/popen,
+		// which is resolved by its public name.
+		if (__atomic_load_n(careful_entries[i].real, __ATOMIC_ACQUIRE))
+			continue;
+		careful_real(careful_entries[i].real, careful_entries[i].name);
+	}
+}
+
+// Resolves the real functions and, in careful mode, enables the identity and
+// comm caches only if the process binds every interposer. Returns whether
+// they are bound.
+bool bpftime_agent_setup_careful(void)
+{
+	careful_resolve_all();
+	bool bound = true;
+	for (size_t i = 0; i < sizeof(careful_entries) / sizeof(careful_entries[0]);
+	     i++) {
+		const struct careful_entry *e = &careful_entries[i];
+		void *real = __atomic_load_n(e->real, __ATOMIC_ACQUIRE);
+		if (e->optional && real == NULL)
+			continue; // this libc has no such function
+		bound = bound && real && dlsym(RTLD_DEFAULT, e->name) == e->hook;
+	}
+#if !CAREFUL_HAVE_VFORK
+	// No vfork interposer on this architecture yet: a vfork child would
+	// run on its parent's cached identity.
+	bound = false;
+#endif
+	if (bpftime_careful_mode) {
+		if (bound)
+			bpftime_identity_enable_cache();
+		else
+			bpftime_identity_disable_cache();
+		bpftime_careful_comm_set_cache_enabled(bound);
+	}
+	return bound;
+}
