index 00000000..68043337
--- /dev/null
+++ b/runtime/unit-test/test_kernel_view.cpp
@@ -0,0 +1,445 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Dview read side (runtime/src/kernel_view.{hpp,cpp}) without a kernel: a
+ * fake view in anonymous memory, published with bpftime_view_attach_for_test
+ * after the same header checks as the real setup. What is checked:
+ *  - hits: both helpers answer from the view;
+ *  - misses (odd seq, other tid, other tgid, STALE, missing valid bits, empty
+ *    slot): the helpers answer the exact system call results, and count;
+ *  - a writer following the BPF programs' seqlock protocol never makes a
+ *    reader return a torn snapshot;
+ *  - invalid headers (magic, abi, nslots, state, pid namespace) leave the
+ *    view off;
+ *  - the comm copy keeps the kernel helper's semantics for every size.
+ * The getuid/getgid wraps of this binary (test_get_current_uid_gid.cpp) pass
+ * through to libc here: the exact results are the process's real ids.
+ */
+#include "catch2/catch_test_macros.hpp"
+#include "kernel_view.hpp"
+
+#include <atomic>
+#include <cerrno>
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <thread>
+#include <sys/mman.h>
+#include <sys/prctl.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+extern "C" {
+uint64_t bpf_get_current_uid_gid(uint64_t, uint64_t, uint64_t, uint64_t,
+				 uint64_t);
+uint64_t bpftime_get_current_comm(uint64_t buf, uint64_t size, uint64_t,
+				  uint64_t, uint64_t);
+}
+
+namespace
+{
+// Values no test process runs with: a hit is told from the fallback by value.
+constexpr uint32_t view_uid = 3000000001u;
+constexpr uint32_t view_gid = 3000000002u;
+constexpr const char *view_comm = "tern-view-ok";
+constexpr uint32_t all_valid = TV_F_IDS | TV_F_CREDS | TV_F_COMM;
+
+uint32_t self_tid()
+{
+	return (uint32_t)syscall(SYS_gettid);
+}
+
+uint32_t self_pid()
+{
+	return (uint32_t)getpid();
+}
+
+uint64_t ids(uint32_t uid, uint32_t gid)
+{
+	return ((uint64_t)gid << 32) | uid;
+}
+
+uint64_t exact_ids()
+{
+	return ids((uint32_t)getuid(), (uint32_t)getgid());
+}
+
+std::string exact_comm()
+{
+	char c[16] = {};
+	REQUIRE(prctl(PR_GET_NAME, c, 0, 0, 0) == 0);
+	c[15] = '\0';
+	return c;
+}
+
+uint64_t helper_ids()
+{
+	return bpf_get_current_uid_gid(0, 0, 0, 0, 0);
+}
+
+// No assertion inside: also called from a worker thread and a fork child,
+// where Catch2 assertions are not usable. "" on failure.
+std::string helper_comm()
+{
+	char b[16];
+	memset(b, 0x5a, sizeof(b));
+	if (bpftime_get_current_comm((uint64_t)(uintptr_t)b, sizeof(b), 0, 0,
+				     0) != 0 ||
+	    b[15] != '\0')
+		return "";
+	return b;
+}
+
+uint64_t misses()
+{
+	return __atomic_load_n(&bpftime_view_misses, __ATOMIC_RELAXED);
+}
+
+// A view as tern_viewd leaves it: header in slot 0, `nslots` slots after
+// it, state LIVE, this process's pid namespace. Withdrawn and unmapped on
+// destruction, so that no other test case sees a view.
+struct fake_view {
+	uint32_t nslots;
+	size_t len;
+	void *mem;
+	tern_view_hdr *hdr;
+	tern_view_slot *slots; // index 1 of the map
+
+	explicit fake_view(uint32_t n) : nslots(n)
+	{
+		len = sizeof(tern_view_slot) * (1 + (size_t)n);
+		mem = mmap(nullptr, len, PROT_READ | PROT_WRITE,
+			   MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+		REQUIRE(mem != MAP_FAILED);
+		hdr = (tern_view_hdr *)mem;
+		slots = (tern_view_slot *)mem + 1;
+		struct stat st;
+		REQUIRE(stat("/proc/self/ns/pid", &st) == 0);
+		hdr->magic = TERN_VIEW_MAGIC;
+		hdr->abi = TERN_VIEW_ABI;
+		hdr->nslots = n;
+		hdr->hook_mode = 1;
+		hdr->pidns_ino = (uint64_t)st.st_ino;
+		hdr->pidns_dev = (uint64_t)st.st_dev;
+		hdr->loader_pid = self_pid();
+		hdr->state = TV_STATE_LIVE;
+	}
+	~fake_view()
+	{
+		bpftime_view_detach_for_test();
+		munmap(mem, len);
+	}
+	fake_view(const fake_view &) = delete;
+	fake_view &operator=(const fake_view &) = delete;
+
+	bool attach()
+	{
+		return bpftime_view_attach_for_test(mem, nslots);
+	}
+	tern_view_slot &slot_of(uint32_t tid)
+	{
+		return slots[tid & (nslots - 1)];
+	}
+	// A complete slot, as the task_newtask hook writes it.
+	tern_view_slot &put(uint32_t tid, uint32_t tgid,
+			    uint32_t flags = all_valid,
+			    const char *comm = view_comm)
+	{
+		tern_view_slot &s = slot_of(tid);
+		s.seq += (s.seq & 1) ? 1 : 2;
+		s.tid = tid;
+		s.tgid = tgid;
+		s.flags = flags;
+		s.uid = view_uid;
+		s.gid = view_gid;
+		s.start_time = 1;
+		memset(s.comm, 0, sizeof(s.comm));
+		strncpy(s.comm, comm, sizeof(s.comm) - 1);
+		s.writer = 1;
+		return s;
+	}
+};
+} // namespace
+
+TEST_CASE("Dview: a hit answers both helpers from the view", "[view]")
+{
+	REQUIRE(exact_ids() != ids(view_uid, view_gid));
+	fake_view v(1024);
+	v.put(self_tid(), self_pid());
+	REQUIRE(v.attach());
+	REQUIRE(bpftime_view_slots == v.slots);
+	const uint64_t m0 = misses();
+	CHECK(helper_ids() == ids(view_uid, view_gid));
+	CHECK(helper_comm() == view_comm);
+	CHECK(misses() == m0);
+
+	// A rename in the view (task_rename hook) is seen at once: there is no
+	// cache to invalidate.
+	tern_view_slot &s = v.slot_of(self_tid());
+	s.seq++;
+	strncpy(s.comm, "renamed", sizeof(s.comm) - 1);
+	memset(s.comm + 7, 0, sizeof(s.comm) - 7);
+	s.seq++;
+	CHECK(helper_comm() == "renamed");
+
+	// Withdrawn: the helpers are back on their paths.
+	bpftime_view_detach_for_test();
+	CHECK(helper_ids() == exact_ids());
+}
+
+TEST_CASE("Dview: misses fall back to the exact system calls", "[view]")
+{
+	const uint64_t exact = exact_ids();
+	const std::string exact_name = exact_comm();
+	REQUIRE(exact_name != view_comm);
+	const uint32_t tid = self_tid(), pid = self_pid();
+	constexpr uint32_t nslots = 1024;
+	const struct {
+		const char *what;
+		void (*mutate)(tern_view_slot &, uint32_t tid, uint32_t pid);
+		bool uid_hit, comm_hit;
+	} cases[] = {
+		{ "writer holds the slot (odd seq)",
+		  [](tern_view_slot &s, uint32_t, uint32_t) { s.seq |= 1; },
+		  false, false },
+		{ "another tid in the same slot",
+		  [](tern_view_slot &s, uint32_t t, uint32_t) {
+			  s.tid = t + nslots;
+		  },
+		  false, false },
+		{ "another tgid",
+		  [](tern_view_slot &s, uint32_t, uint32_t p) {
+			  s.tgid = p + 1;
+		  },
+		  false, false },
+		{ "STALE (loader stopping, writer gave up)",
+		  [](tern_view_slot &s, uint32_t, uint32_t) {
+			  s.flags |= TV_F_STALE;
+		  },
+		  false, false },
+		{ "no comm yet: uid hits, comm falls back",
+		  [](tern_view_slot &s, uint32_t, uint32_t) {
+			  s.flags = TV_F_IDS | TV_F_CREDS;
+		  },
+		  true, false },
+		{ "no creds yet: comm hits, uid falls back",
+		  [](tern_view_slot &s, uint32_t, uint32_t) {
+			  s.flags = TV_F_IDS | TV_F_COMM;
+		  },
+		  false, true },
+		{ "ids not valid",
+		  [](tern_view_slot &s, uint32_t, uint32_t) {
+			  s.flags = TV_F_CREDS | TV_F_COMM;
+		  },
+		  false, false },
+		{ "empty slot (exit hook cleared it)",
+		  [](tern_view_slot &s, uint32_t, uint32_t) {
+			  s.tid = 0;
+			  s.flags = 0;
+		  },
+		  false, false },
+	};
+	for (const auto &c : cases) {
+		CAPTURE(c.what);
+		fake_view v(nslots);
+		c.mutate(v.put(tid, pid), tid, pid);
+		REQUIRE(v.attach());
+		const uint64_t m0 = misses();
+		CHECK(helper_ids() ==
+		      (c.uid_hit ? ids(view_uid, view_gid) : exact));
+		CHECK(helper_comm() == (c.comm_hit ? std::string(view_comm) :
+						     exact_name));
+		CHECK(misses() - m0 ==
+		      (uint64_t)(!c.uid_hit) + (uint64_t)(!c.comm_hit));
+	}
+}
+
+TEST_CASE("Dview: other threads and fork children read their own slots",
+	  "[view]")
+{
+	fake_view v(1u << 16);
+	const uint32_t main_tid = self_tid(), pid = self_pid();
+	v.put(main_tid, pid);
+	REQUIRE(v.attach());
+
+	// A new thread: no slot of its own yet, so it must not get the main
+	// thread's values (key check), then its own once written.
+	std::atomic<int> before{ -1 }, after{ -1 };
+	std::thread t([&] {
+		const uint32_t tid = self_tid();
+		if ((tid & (v.nslots - 1)) == (main_tid & (v.nslots - 1))) {
+			before = after = 2; // collision: nothing to check
+			return;
+		}
+		before = helper_ids() == exact_ids();
+		v.put(tid, pid, all_valid, "worker-slot");
+		after = helper_ids() == ids(view_uid, view_gid) &&
+			helper_comm() == "worker-slot";
+	});
+	t.join();
+	// Asserted here: Catch2 assertions are not usable in the worker.
+	const int saw_before = before.load(), saw_after = after.load();
+	CHECK(saw_before != 0);
+	CHECK(saw_after != 0);
+	CHECK(helper_comm() == view_comm);
+
+	// A fork child (the identity cache is reset by the fork handler): its
+	// own tid and tgid, so the parent's slot is not its. The mapping is
+	// MAP_PRIVATE here; the child writes its own copy.
+	const pid_t child = fork();
+	REQUIRE(child >= 0);
+	if (child == 0) {
+		if (helper_ids() != exact_ids())
+			_exit(1);
+		const uint32_t ctid = self_tid(), cpid = self_pid();
+		if ((ctid & (v.nslots - 1)) != (main_tid & (v.nslots - 1))) {
+			v.put(ctid, cpid, all_valid, "child-slot");
+			if (helper_ids() != ids(view_uid, view_gid) ||
+			    helper_comm() != "child-slot")
+				_exit(2);
+		}
+		_exit(0);
+	}
+	int status = -1;
+	REQUIRE(waitpid(child, &status, 0) == child);
+	REQUIRE(WIFEXITED(status));
+	CHECK(WEXITSTATUS(status) == 0);
+}
+
+TEST_CASE("Dview: a reader never returns a torn slot", "[view]")
+{
+	fake_view v(64);
+	const uint32_t tid = self_tid(), pid = self_pid();
+	tern_view_slot &s = v.put(tid, pid);
+	REQUIRE(v.attach());
+
+	// The BPF writers' protocol: seq to odd, the fields, seq to even
+	// (view.bpf.c uses cmpxchg and fetch_add; one writer here needs only
+	// the orderings). Every update writes uid == gid == i and comm ==
+	// {w, ~w} with w built from i: a snapshot mixing two updates breaks
+	// one of the equalities.
+	std::atomic<bool> stop{ false };
+	std::thread writer([&] {
+		auto *cw = (bpftime_view_u64_alias *)s.comm;
+		for (uint32_t i = 1; !stop.load(std::memory_order_relaxed);
+		     i++) {
+			const uint32_t q =
+				__atomic_load_n(&s.seq, __ATOMIC_RELAXED);
+			__atomic_store_n(&s.seq, q + 1, __ATOMIC_RELAXED);
+			// The odd seq before any field store.
+			__atomic_thread_fence(__ATOMIC_RELEASE);
+			const uint64_t w = ((uint64_t)i << 32) | i;
+			__atomic_store_n(&s.uid, i, __ATOMIC_RELAXED);
+			__atomic_store_n(&cw[0], w, __ATOMIC_RELAXED);
+			__atomic_store_n(&s.gid, i, __ATOMIC_RELAXED);
+			__atomic_store_n(&cw[1], ~w, __ATOMIC_RELAXED);
+			__atomic_store_n(&s.seq, q + 2, __ATOMIC_RELEASE);
+		}
+	});
+	uint64_t hits = 0, torn = 0;
+	for (int n = 0; n < 1000000; n++) {
+		uint32_t u = 0, g = 0;
+		char comm[16];
+		if (!bpftime_view_read(tid, pid, all_valid, &u, &g, comm))
+			continue;
+		hits++;
+		uint64_t w0, w1;
+		memcpy(&w0, comm, 8);
+		memcpy(&w1, comm + 8, 8);
+		// The initial slot (view_uid/view_gid, a text comm) is
+		// consistent too, but not in this encoding: skip it.
+		if (u == view_uid && g == view_gid)
+			continue;
+		const uint64_t w = ((uint64_t)u << 32) | u;
+		if (u != g || w0 != w || w1 != ~w)
+			torn++;
+	}
+	stop = true;
+	writer.join();
+	CHECK(torn == 0);
+	CHECK(hits > 0);
+}
+
+TEST_CASE("Dview: invalid headers leave the view off", "[view]")
+{
+	const uint64_t exact = exact_ids();
+	const struct {
+		const char *what;
+		uint32_t nslots;
+		void (*mutate)(tern_view_hdr &);
+	} cases[] = {
+		{ "magic", 1024,
+		  [](tern_view_hdr &h) { h.magic ^= 1; } },
+		{ "abi", 1024, [](tern_view_hdr &h) { h.abi += 1; } },
+		{ "state INIT (loader not done)", 1024,
+		  [](tern_view_hdr &h) { h.state = TV_STATE_INIT; } },
+		{ "state DEAD (loader stopping)", 1024,
+		  [](tern_view_hdr &h) { h.state = TV_STATE_DEAD; } },
+		{ "header nslots differs from the map", 1024,
+		  [](tern_view_hdr &h) { h.nslots = 2048; } },
+		{ "nslots not a power of two", 24, [](tern_view_hdr &) {} },
+		{ "another pid namespace (inode)", 1024,
+		  [](tern_view_hdr &h) { h.pidns_ino += 1; } },
+		{ "another pid namespace (device)", 1024,
+		  [](tern_view_hdr &h) { h.pidns_dev += 1; } },
+	};
+	for (const auto &c : cases) {
+		CAPTURE(c.what);
+		fake_view v(c.nslots);
+		v.put(self_tid(), self_pid());
+		c.mutate(*v.hdr);
+		CHECK_FALSE(v.attach());
+		CHECK(bpftime_view_slots == nullptr);
+		CHECK(helper_ids() == exact);
+		CHECK(helper_comm() != view_comm);
+	}
+	// The unmodified header is accepted (the cases above fail for their
+	// mutation only).
+	fake_view ok(1024);
+	CHECK(ok.attach());
+}
+
+TEST_CASE("Dview: comm copies keep the kernel helper's semantics",
+	  "[view]")
+{
+	fake_view v(1024);
+	// 15 characters: the longest name a task has.
+	const char *name = "abcdefghijklmno";
+	v.put(self_tid(), self_pid(), all_valid, name);
+	REQUIRE(v.attach());
+	auto comm_of_size = [](char *buf, uint64_t size) {
+		return bpftime_get_current_comm((uint64_t)(uintptr_t)buf, size,
+						0, 0, 0);
+	};
+	// Larger than TASK_COMM_LEN: the name, then zeros to the end.
+	{
+		char buf[32];
+		memset(buf, 0x5a, sizeof(buf));
+		REQUIRE(comm_of_size(buf, sizeof(buf)) == 0);
+		CHECK(std::string(buf) == name);
+		for (size_t i = 15; i < sizeof(buf); i++)
+			CHECK(buf[i] == '\0');
+	}
+	// Smaller: truncated to size - 1 and terminated.
+	{
+		char buf[8];
+		memset(buf, 0x5a, sizeof(buf));
+		REQUIRE(comm_of_size(buf, sizeof(buf)) == 0);
+		CHECK(std::string(buf) == "abcdefg");
+	}
+	// size 1: only the terminator.
+	{
+		char buf[1] = { 0x5a };
+		REQUIRE(comm_of_size(buf, 1) == 0);
+		CHECK(buf[0] == '\0');
+	}
+	// size 0: not touched.
+	{
+		char buf[4];
+		memset(buf, 0x5a, sizeof(buf));
+		REQUIRE(comm_of_size(buf, 0) == 0);
+		for (char c : buf)
+			CHECK(c == 0x5a);
+	}
+}
