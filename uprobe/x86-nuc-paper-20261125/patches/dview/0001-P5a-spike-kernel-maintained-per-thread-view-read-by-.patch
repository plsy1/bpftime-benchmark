diff --git a/runtime/include/bpftime_view_abi.h b/runtime/include/bpftime_view_abi.h
new file mode 100644
index 00000000..46657914
--- /dev/null
+++ b/runtime/include/bpftime_view_abi.h
@@ -0,0 +1,146 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef BPFTIME_VIEW_ABI_H
+#define BPFTIME_VIEW_ABI_H
+
+/*
+ * Kernel thread view ("Dview"): the layout shared by the kernel eBPF writer
+ * (tools/view/view.bpf.c), its privileged loader (tools/view/tern_viewd.c),
+ * the standalone selftest and the runtime's read-only reader
+ * (runtime/src/kernel_view.hpp).
+ *
+ * The view is one BPF_MAP_TYPE_ARRAY with BPF_F_MMAPABLE and 64-byte values:
+ * index 0 holds a tern_view_hdr, index 1 + (tid & (nslots - 1)) the slot of
+ * thread tid (init pid namespace). The kernel keeps every slot current from
+ * five hooks (task_newtask, commit_creds, task_rename, sched_process_exec,
+ * sched_process_exit); the runtime maps the array PROT_READ and reads its own
+ * thread's slot without a syscall.
+ *
+ * Seqlock: seq is even when the slot is stable and odd while a writer holds
+ * it. Writers take it with a compare-and-swap from an even value to value+1
+ * and release it with a fetch-and-add of 1 (both full barriers), so writers
+ * on different CPUs (a /proc comm write racing the target's own setresuid)
+ * exclude each other. A reader loads seq (acquire), the fields, a fence and
+ * seq again, and retries or falls back when seq was odd or changed. A value
+ * cannot carry a bpf_spin_lock: bpf_map_mmap refuses maps whose value has a
+ * BTF record (kernel/bpf/syscall.c), hence the hand-made lock.
+ *
+ * Validity: a reader takes a slot only when tid and tgid equal its own key,
+ * TV_F_STALE is clear and every bit it needs is set; anything else is a miss
+ * and the caller uses its exact syscall path. Each hook sets only the bits of
+ * the fields it wrote, so a slot rekeyed by a partial hook (a thread that
+ * existed before the loader, or a slot collision) never claims fields it did
+ * not fill.
+ *
+ * Usable from BPF C (include vmlinux.h first, which defines __VMLINUX_H__ and
+ * the __u32/__u64 types), from C and from C++ (via <linux/types.h>). The
+ * layout is fixed: TERN_VIEW_ABI changes with any change to it.
+ */
+
+#ifndef __VMLINUX_H__
+#if defined(__linux__)
+#include <linux/types.h>
+#else
+/* The runtime also builds on darwin (compat/darwin/include has a linux/bpf.h
+ * shim but no linux/types.h), and bpf_helper.cpp includes this header there
+ * through kernel_view.hpp. The view itself is Linux-only; only the layout
+ * has to compile. */
+#include <stdint.h>
+typedef uint32_t __u32;
+typedef uint64_t __u64;
+#endif
+#endif
+
+#define TERN_VIEW_MAGIC 0x5745495654524554ull /* "TERNVIEW" little-endian */
+#define TERN_VIEW_ABI 1
+
+/* Valid bits in tern_view_slot.flags. */
+#define TV_F_IDS 1u /* tid/tgid valid */
+#define TV_F_CREDS 2u /* uid/gid valid */
+#define TV_F_COMM 4u /* comm valid */
+#define TV_F_ALL (TV_F_IDS | TV_F_CREDS | TV_F_COMM)
+/* An update was lost (a writer could not take the lock, or the view is
+ * stopping): the slot must not be used until a full refresh rewrites it. */
+#define TV_F_STALE 0x80000000u
+
+/* tern_view_hdr.state. INIT until the loader has attached every hook and
+ * written the header; DEAD once `tern_viewd stop` began (slots are being made
+ * STALE and the hooks are about to be detached). */
+enum { TV_STATE_INIT = 0, TV_STATE_LIVE = 1, TV_STATE_DEAD = 2 };
+
+/* tern_view_hdr.hook_mode: which commit_creds program is attached. */
+enum { TV_HOOK_NONE = 0, TV_HOOK_FEXIT = 1, TV_HOOK_FENTRY = 2, TV_HOOK_KPROBE = 3 };
+
+/* tern_view_slot.writer (debugging: the hook that wrote the slot last). */
+enum {
+	TV_W_NEWTASK = 1,
+	TV_W_CREDS = 2,
+	TV_W_RENAME = 3,
+	TV_W_EXEC = 4,
+	TV_W_REKEY = 5,
+};
+
+/* Per-CPU counters of the view program (tv_stats map, u64 per index); the
+ * loader's `status` sums them. Not part of the reader ABI. */
+enum {
+	TV_ST_NEWTASK = 0, /* full fill at task_newtask */
+	TV_ST_CREDS, /* commit_creds update (any hook mode) */
+	TV_ST_RENAME, /* task_rename update */
+	TV_ST_EXEC, /* full fill at sched_process_exec */
+	TV_ST_EXIT, /* slot cleared at sched_process_exit */
+	TV_ST_REKEY, /* a partial hook (creds/rename) took over a slot */
+	TV_ST_COLLISION, /* a slot holding another live-or-stale tid was taken over */
+	TV_ST_LOCK_FAIL, /* lock not taken in the spin bound: slot made STALE */
+	TV_ST_DEAD_WRITE, /* write after state DEAD: slot made STALE */
+	TV_ST_EXEC_CLEAR, /* old tid of a non-leader exec cleared */
+	TV_ST__COUNT,
+};
+
+/* 64 bytes, one cache line. The value area of an mmapable array starts page
+ * aligned, so every slot is line aligned and comm is 8-byte aligned (a reader
+ * may load it as two u64). */
+struct tern_view_slot {
+	__u32 seq; /* even = stable, odd = a writer holds the slot */
+	__u32 tid, tgid; /* init pid namespace; tid == 0: empty */
+	__u32 flags; /* TV_F_* */
+	__u32 uid, gid; /* cred->uid.val / gid.val: kuid/kgid (init user ns),
+			   the same values bpf_get_current_uid_gid returns */
+	__u64 start_time; /* task->start_time; exit clears only on a match */
+	char comm[16]; /* <= 15 chars, NUL padded (strscpy_pad semantics) */
+	__u32 writer, _r; /* TV_W_* of the last writer (debugging) */
+	__u64 _pad;
+};
+
+/* Index 0 of the map, 64 bytes. Written by the loader through an RW mapping;
+ * state is stored last (release). */
+struct tern_view_hdr {
+	__u64 magic; /* TERN_VIEW_MAGIC */
+	__u32 abi, nslots, state, hook_mode; /* nslots: power of two */
+	__u64 pidns_ino, pidns_dev; /* stat("/proc/self/ns/pid") of the loader */
+	__u32 loader_pid, _r;
+	__u64 _pad[2];
+};
+
+/* Slot index of thread tid in the map (index 0 is the header). */
+#define TV_SLOT_INDEX(tid, nslots) (1u + ((__u32)(tid) & ((__u32)(nslots) - 1u)))
+
+/* Defaults shared by the loader and the runtime. 2^18 slots (16 MiB): with
+ * ~1100 threads on the machine a given thread shares its slot with another
+ * one with probability ~0.4% (1.7% at 2^16), so an nginx run rarely has a
+ * worker that falls back for its whole life. */
+#define TV_DEFAULT_NSLOTS_LOG2 18
+#define TV_DEFAULT_PIN "/sys/fs/bpf/tern_view/view"
+
+#ifdef __cplusplus
+#define TV_STATIC_ASSERT(c, m) static_assert(c, m)
+#else
+#define TV_STATIC_ASSERT(c, m) _Static_assert(c, m)
+#endif
+TV_STATIC_ASSERT(sizeof(struct tern_view_slot) == 64, "tern_view_slot is 64 bytes");
+TV_STATIC_ASSERT(sizeof(struct tern_view_hdr) == 64, "tern_view_hdr is 64 bytes");
+TV_STATIC_ASSERT(__builtin_offsetof(struct tern_view_slot, comm) == 32,
+		 "comm is 8-byte aligned at offset 32");
+TV_STATIC_ASSERT(__builtin_offsetof(struct tern_view_hdr, state) == 16,
+		 "hdr.state offset is part of the ABI");
+#undef TV_STATIC_ASSERT
+
+#endif /* BPFTIME_VIEW_ABI_H */
diff --git a/runtime/src/bpf_helper.cpp b/runtime/src/bpf_helper.cpp
index 18b5f904..36b8854c 100644
--- a/runtime/src/bpf_helper.cpp
+++ b/runtime/src/bpf_helper.cpp
@@ -66,6 +66,7 @@
 #include <utility>
 #include <bpftime_shm_internal.hpp>
 #include "producer_identity.hpp"
+#include "kernel_view.hpp"
 #if __linux__
 #include <sys/prctl.h>
 #endif
@@ -717,6 +718,31 @@ uint64_t query_credentials()
 	return (static_cast<uint64_t>(getgid()) << 32) |
 	       static_cast<uint32_t>(getuid());
 }
+
+// Dview (kernel_view.hpp): the calling thread's kuid/kgid from the kernel
+// view, keyed by the cached thread identity. A miss queries exactly and
+// never uses or fills the process-wide cache: that cache is what raw
+// setresuid in one thread defeats (it changes only that thread, and the
+// interposers never see it). Out of line, so that the view-off path of
+// bpf_get_current_uid_gid is one load and a branch.
+//
+// Semantics: the view holds cred->uid.val/gid.val, the init user namespace
+// ids, as the kernel helper returns; getuid() on a miss returns the ids of
+// the caller's user namespace. The two agree in the init user namespace
+// (E5, nginx).
+[[gnu::noinline]] uint64_t view_get_current_uid_gid()
+{
+	int pid;
+	int64_t tid;
+	bpftime::current_producer_identity(pid, tid);
+	uint32_t uid, gid;
+	bpftime_view_count_read();
+	if (bpftime_view_read((uint32_t)tid, (uint32_t)pid,
+			      TV_F_IDS | TV_F_CREDS, &uid, &gid, nullptr))
+		return (static_cast<uint64_t>(gid) << 32) | uid;
+	bpftime_view_count_miss();
+	return query_credentials();
+}
 } // namespace
 
 extern "C" void bpftime_set_credential_cache_enabled(bool enabled)
@@ -734,6 +760,11 @@ extern "C" void bpftime_invalidate_credential_cache()
 uint64_t bpf_get_current_uid_gid(uint64_t, uint64_t, uint64_t, uint64_t,
 				 uint64_t)
 {
+	// Before the credential cache: with a view, the cache is not used.
+	if (__builtin_expect(__atomic_load_n(&bpftime_view_slots,
+					     __ATOMIC_RELAXED) != nullptr,
+			     0))
+		return view_get_current_uid_gid();
 	if (!credential_cache_enabled.load(std::memory_order_acquire))
 		return query_credentials();
 	auto value = cached_credentials.load(std::memory_order_acquire);
@@ -885,6 +916,53 @@ void careful_copy_comm(char *buf, uint64_t size, const char *comm)
 	buf[n - 1] = '\0';
 }
 
+// The calling thread's comm, read now (prctl(PR_GET_NAME): no allocation,
+// async-signal-safe), as the kernel helper returns it. false: prctl failed.
+bool read_thread_comm(char comm[16])
+{
+	memset(comm, 0, 16);
+	if (prctl(PR_GET_NAME, comm, 0, 0, 0) != 0)
+		return false;
+	comm[15] = '\0';
+	return true;
+}
+
+// The exact comm path without any cache: the careful mode refill path,
+// minus the fill. On failure the buffer is zeroed and -EINVAL returned, as
+// careful_get_current_comm does.
+uint64_t read_comm_exact(uint64_t buf, uint64_t size)
+{
+	char comm[16];
+	if (!read_thread_comm(comm)) {
+		if (size)
+			memset((void *)(uintptr_t)buf, 0, (size_t)size);
+		return (uint64_t)(int64_t)-EINVAL;
+	}
+	careful_copy_comm((char *)(uintptr_t)buf, size, comm);
+	return 0;
+}
+
+// Dview (kernel_view.hpp): the calling thread's comm from the kernel view,
+// which also sees renames the careful interposers do not (raw prctl, writes
+// to /proc/<pid>/task/<tid>/comm by this or another thread). A miss reads
+// the name exactly and caches nothing. Out of line: the view-off path of
+// bpftime_get_current_comm stays one load and a branch.
+[[gnu::noinline]] uint64_t view_get_current_comm(uint64_t buf, uint64_t size)
+{
+	int pid;
+	int64_t tid;
+	bpftime::current_producer_identity(pid, tid);
+	char comm[16];
+	bpftime_view_count_read();
+	if (bpftime_view_read((uint32_t)tid, (uint32_t)pid,
+			      TV_F_IDS | TV_F_COMM, nullptr, nullptr, comm)) {
+		careful_copy_comm((char *)(uintptr_t)buf, size, comm);
+		return 0;
+	}
+	bpftime_view_count_miss();
+	return read_comm_exact(buf, size);
+}
+
 // Out of line and cold: the switch-off path of bpftime_get_current_comm stays
 // as it was.
 [[gnu::noinline, gnu::cold]] uint64_t careful_get_current_comm(uint64_t buf,
@@ -897,13 +975,12 @@ void careful_copy_comm(char *buf, uint64_t size, const char *comm)
 		careful_copy_comm((char *)(uintptr_t)buf, size, e.comm);
 		return 0;
 	}
-	char comm[16] = {};
-	if (prctl(PR_GET_NAME, comm, 0, 0, 0) != 0) {
+	char comm[16];
+	if (!read_thread_comm(comm)) {
 		if (size)
 			memset((void *)(uintptr_t)buf, 0, (size_t)size);
 		return (uint64_t)(int64_t)-EINVAL;
 	}
-	comm[15] = '\0';
 	if (careful_comm_cache_enabled.load(std::memory_order_relaxed) &&
 	    e.renaming == 0 && bpftime_careful_spawning == 0 &&
 	    !bpftime_identity_tls_shared() &&
@@ -944,6 +1021,12 @@ uint64_t bpftime_get_current_comm(uint64_t buf, uint64_t size, uint64_t,
 				  uint64_t, uint64_t)
 {
 #if __linux__
+	// The view first: it answers for the careful mode too (exactly, where
+	// the careful cache misses renames it cannot see).
+	if (__builtin_expect(__atomic_load_n(&bpftime_view_slots,
+					     __ATOMIC_RELAXED) != nullptr,
+			     0))
+		return view_get_current_comm(buf, size);
 	if (__builtin_expect(bpftime_careful_mode, 0))
 		return careful_get_current_comm(buf, size);
 #endif
diff --git a/runtime/src/kernel_view.cpp b/runtime/src/kernel_view.cpp
new file mode 100644
index 00000000..5c7b8dfa
--- /dev/null
+++ b/runtime/src/kernel_view.cpp
@@ -0,0 +1,456 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Dview (P5a): read side of the kernel-maintained thread view. See
+ * kernel_view.hpp for the model, tools/view/view.bpf.c for the writers and
+ * tools/view/tern_viewd.c for the loader that creates and pins the map.
+ */
+#include "kernel_view.hpp"
+#include "fork_handlers.hpp"
+#include "spdlog/spdlog.h"
+#include <atomic>
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#if __linux__
+#include <fcntl.h>
+#include <linux/bpf.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#endif
+
+extern "C" {
+// Read once at load, like bpftime_careful_mode (producer_identity.cpp):
+// nginx clears its workers' environment, and they inherit these.
+bool bpftime_view_mode = [] {
+	const char *e = getenv("BPFTIME_VIEW");
+	return e != nullptr && e[0] == '1';
+}();
+bool bpftime_view_count_reads = [] {
+	const char *e = getenv("BPFTIME_VIEW_COUNT");
+	return e != nullptr && e[0] == '1';
+}();
+const struct tern_view_slot *bpftime_view_slots = nullptr;
+uint32_t bpftime_view_mask = 0;
+uint64_t bpftime_view_reads = 0;
+uint64_t bpftime_view_misses = 0;
+}
+
+namespace
+{
+// BPFTIME_VIEW_LOG_FORK=1: fork children of a process with a view write
+// "View: mapped (inherited) pid <p>" to stderr. nginx workers inherit the
+// master's mapping and never run the agent's setup, so this is how their
+// logs show that they read the view; off by default because targets that
+// churn processes (E5 W12) would flood their logs.
+const bool view_log_fork = [] {
+	const char *e = getenv("BPFTIME_VIEW_LOG_FORK");
+	return e != nullptr && e[0] == '1';
+}();
+
+// "off" until bpftime_view_setup ran with the switch on. Written once, by
+// the one setup call, before anything reads it.
+char view_status[256] = "off";
+
+// Async-signal-safe formatting for the fork child handler (the parent may
+// be multithreaded: no stdio, no allocation there) and the exit report.
+char *put_str(char *p, char *end, const char *s)
+{
+	while (*s && p < end)
+		*p++ = *s++;
+	return p;
+}
+
+char *put_u64(char *p, char *end, uint64_t v)
+{
+	char digits[24];
+	int n = 0;
+	do {
+		digits[n++] = (char)('0' + v % 10);
+		v /= 10;
+	} while (v != 0);
+	while (n > 0 && p < end)
+		*p++ = digits[--n];
+	return p;
+}
+
+void write_stderr(const char *buf, size_t len)
+{
+#if __linux__
+	// Best effort: a closed or redirected stderr only loses the line.
+	while (len > 0) {
+		const ssize_t w = write(2, buf, len);
+		if (w <= 0) {
+			if (w < 0 && errno == EINTR)
+				continue;
+			return;
+		}
+		buf += w;
+		len -= (size_t)w;
+	}
+#else
+	(void)buf;
+	(void)len;
+#endif
+}
+
+void view_fork_child()
+{
+	// The child's statistics are its own (an nginx worker's miss rate must
+	// not include the master's reads before the fork).
+	__atomic_store_n(&bpftime_view_reads, 0, __ATOMIC_RELAXED);
+	__atomic_store_n(&bpftime_view_misses, 0, __ATOMIC_RELAXED);
+	if (view_log_fork &&
+	    __atomic_load_n(&bpftime_view_slots, __ATOMIC_RELAXED) != nullptr) {
+		char line[96];
+		char *end = line + sizeof(line), *p = line;
+		p = put_str(p, end, "View: mapped (inherited) pid ");
+#if __linux__
+		p = put_u64(p, end, (uint64_t)syscall(SYS_getpid));
+#endif
+		p = put_str(p, end, "\n");
+		write_stderr(line, (size_t)(p - line));
+	}
+}
+
+const int view_atfork_status =
+	bpftime::register_fork_handlers(nullptr, nullptr, view_fork_child);
+
+// Exit report of every process that had a view, on stderr rather than
+// through spdlog: the agent turns its logger off at exit
+// (bpftime_quiet_logger_at_exit), before destructors of this library run.
+__attribute__((destructor)) void view_exit_report()
+{
+	if (__atomic_load_n(&bpftime_view_slots, __ATOMIC_RELAXED) == nullptr)
+		return;
+	char line[128];
+	char *end = line + sizeof(line), *p = line;
+	p = put_str(p, end, "View: reads ");
+	if (bpftime_view_count_reads)
+		p = put_u64(p, end,
+			    __atomic_load_n(&bpftime_view_reads,
+					    __ATOMIC_RELAXED));
+	else
+		p = put_str(p, end, "off");
+	p = put_str(p, end, " misses ");
+	p = put_u64(p, end,
+		    __atomic_load_n(&bpftime_view_misses, __ATOMIC_RELAXED));
+#if __linux__
+	p = put_str(p, end, " pid ");
+	p = put_u64(p, end, (uint64_t)syscall(SYS_getpid));
+#endif
+	p = put_str(p, end, "\n");
+	write_stderr(line, (size_t)(p - line));
+}
+
+bool is_power_of_two(uint64_t n)
+{
+	return n != 0 && (n & (n - 1)) == 0;
+}
+
+// Header checks shared by the real setup and the test hook. nullptr: the
+// header describes a live view for this process; otherwise the reason,
+// formatted into buf.
+const char *check_header(const tern_view_hdr *h, uint32_t nslots, char *buf,
+			 size_t buf_len)
+{
+	// The loader writes the header through its RW mapping and stores
+	// state = LIVE last: read state first (acquire), then the rest.
+	const uint32_t state = __atomic_load_n(&h->state, __ATOMIC_ACQUIRE);
+	const uint64_t magic = __atomic_load_n(&h->magic, __ATOMIC_RELAXED);
+	const uint32_t abi = __atomic_load_n(&h->abi, __ATOMIC_RELAXED);
+	const uint32_t hdr_nslots = __atomic_load_n(&h->nslots, __ATOMIC_RELAXED);
+	if (magic != TERN_VIEW_MAGIC) {
+		snprintf(buf, buf_len, "bad magic 0x%llx",
+			 (unsigned long long)magic);
+		return buf;
+	}
+	if (abi != TERN_VIEW_ABI) {
+		snprintf(buf, buf_len, "abi %u, runtime has %u", abi,
+			 (unsigned)TERN_VIEW_ABI);
+		return buf;
+	}
+	if (hdr_nslots != nslots || !is_power_of_two(nslots)) {
+		snprintf(buf, buf_len, "header nslots %u, map has %u slots",
+			 hdr_nslots, nslots);
+		return buf;
+	}
+	// INIT: the loader has not finished (hooks may not all be attached);
+	// DEAD: it is stopping, slots are being made STALE. Neither is a view
+	// to start reading.
+	if (state != TV_STATE_LIVE) {
+		snprintf(buf, buf_len, "state %u, not LIVE", state);
+		return buf;
+	}
+#if __linux__
+	// The slots hold init-namespace tids written by a loader in its own
+	// pid namespace; the runtime's keys are this process's ids. Unless the
+	// namespaces are the same (inode and device of the nsfs file), a key
+	// would select another task's slot.
+	struct stat st;
+	if (stat("/proc/self/ns/pid", &st) != 0) {
+		snprintf(buf, buf_len, "cannot stat /proc/self/ns/pid: %s",
+			 strerror(errno));
+		return buf;
+	}
+	const uint64_t ino = __atomic_load_n(&h->pidns_ino, __ATOMIC_RELAXED);
+	const uint64_t dev = __atomic_load_n(&h->pidns_dev, __ATOMIC_RELAXED);
+	if (ino != (uint64_t)st.st_ino || dev != (uint64_t)st.st_dev) {
+		snprintf(buf, buf_len,
+			 "pid namespace %llu:%llu, loader's %llu:%llu",
+			 (unsigned long long)st.st_dev,
+			 (unsigned long long)st.st_ino,
+			 (unsigned long long)dev, (unsigned long long)ino);
+		return buf;
+	}
+#endif
+	return nullptr;
+}
+
+// Mask first: a reader that sees the slots sees at worst an older mask (0),
+// which stays inside the array (kernel_view.hpp).
+void publish(const void *base, uint32_t nslots)
+{
+	__atomic_store_n(&bpftime_view_mask, nslots - 1, __ATOMIC_RELEASE);
+	__atomic_store_n(&bpftime_view_slots,
+			 (const tern_view_slot *)base + 1, __ATOMIC_RELEASE);
+}
+
+#if __linux__
+// The calling thread's slot, for the log line only: a miss (a thread that
+// existed before the loader started, a collision) is no reason to keep the
+// view off, since misses fall back to the exact path.
+bool self_hit()
+{
+	const uint32_t tid = (uint32_t)syscall(SYS_gettid);
+	const uint32_t tgid = (uint32_t)syscall(SYS_getpid);
+	uint32_t uid, gid;
+	return bpftime_view_read(tid, tgid, TV_F_IDS | TV_F_CREDS, &uid, &gid,
+				 nullptr);
+}
+
+// Raw bpf(2): the runtime is built without libbpf in some configurations
+// (array_map_kernel_user.cpp is only in the BPFTIME_BUILD_WITH_LIBBPF
+// build), and the view must not change the build of Dnextpc. The whole
+// union is passed, zeroed: the kernel accepts a larger attr whose tail is
+// zero.
+long sys_bpf(int cmd, union bpf_attr *attr)
+{
+	return syscall(__NR_bpf, cmd, attr, sizeof(*attr));
+}
+
+int view_fd_from_pin(const char *path)
+{
+	union bpf_attr attr;
+	memset(&attr, 0, sizeof(attr));
+	attr.pathname = (uint64_t)(uintptr_t)path;
+	// Not BPF_F_RDONLY: on 6.12 a MAP_SHARED mapping of a read-only fd has
+	// VM_SHARED cleared by mmap(2), and bpf_map_mmap refuses it (EINVAL).
+	// The fd is used only for a PROT_READ mapping and closed at once; the
+	// kernel then clears VM_MAYWRITE, so the mapping cannot be made
+	// writable (mprotect refused; checked by view_selftest M0).
+	attr.file_flags = 0;
+	return (int)sys_bpf(BPF_OBJ_GET, &attr);
+}
+
+// The map id the loader wrote (decimal). 0: no usable id.
+uint32_t read_id_file(const char *path, char *err, size_t err_len)
+{
+	const int fd = open(path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0) {
+		snprintf(err, err_len, "open %s: %s", path, strerror(errno));
+		return 0;
+	}
+	char buf[32];
+	ssize_t n;
+	do
+		n = read(fd, buf, sizeof(buf) - 1);
+	while (n < 0 && errno == EINTR);
+	close(fd);
+	if (n <= 0) {
+		snprintf(err, err_len, "read %s: empty", path);
+		return 0;
+	}
+	buf[n] = '\0';
+	char *endp = nullptr;
+	errno = 0;
+	const unsigned long id = strtoul(buf, &endp, 10);
+	if (errno != 0 || endp == buf || id == 0 || id > UINT32_MAX) {
+		snprintf(err, err_len, "%s holds no map id", path);
+		return 0;
+	}
+	return (uint32_t)id;
+}
+
+int view_fd_from_id(uint32_t id)
+{
+	union bpf_attr attr;
+	memset(&attr, 0, sizeof(attr));
+	attr.map_id = id;
+	attr.open_flags = 0; // see view_fd_from_pin
+	return (int)sys_bpf(BPF_MAP_GET_FD_BY_ID, &attr);
+}
+
+// Same size as libbpf's bpf_map_mmap_sz (array_map_kernel_user.cpp): the
+// value area of an mmapable array starts at offset 0 of the mapping.
+size_t view_mmap_size(uint32_t value_size, uint32_t max_entries)
+{
+	const long page = sysconf(_SC_PAGE_SIZE);
+	const size_t page_sz = page > 0 ? (size_t)page : 4096;
+	size_t sz = (((size_t)value_size + 7) / 8 * 8) * (size_t)max_entries;
+	return (sz + page_sz - 1) / page_sz * page_sz;
+}
+
+// Validates the map behind fd and maps it read-only. nullptr on failure
+// (reason in err); fd is always left to the caller.
+const void *map_view(int fd, uint32_t &nslots, char *err, size_t err_len)
+{
+	struct bpf_map_info info;
+	memset(&info, 0, sizeof(info));
+	union bpf_attr attr;
+	memset(&attr, 0, sizeof(attr));
+	attr.info.bpf_fd = (uint32_t)fd;
+	attr.info.info_len = sizeof(info);
+	attr.info.info = (uint64_t)(uintptr_t)&info;
+	if (sys_bpf(BPF_OBJ_GET_INFO_BY_FD, &attr) != 0) {
+		snprintf(err, err_len, "BPF_OBJ_GET_INFO_BY_FD: %s",
+			 strerror(errno));
+		return nullptr;
+	}
+	// The index is 1 + (tid & (nslots - 1)): one header slot plus a
+	// power-of-two number of slots, 64-byte values, u32 keys.
+	if (info.type != BPF_MAP_TYPE_ARRAY ||
+	    !(info.map_flags & BPF_F_MMAPABLE) ||
+	    info.value_size != sizeof(tern_view_slot) || info.key_size != 4 ||
+	    info.max_entries < 2 || !is_power_of_two(info.max_entries - 1)) {
+		snprintf(err, err_len,
+			 "not a view map (type %u flags 0x%x key %u value %u "
+			 "entries %u)",
+			 info.type, info.map_flags, info.key_size,
+			 info.value_size, info.max_entries);
+		return nullptr;
+	}
+	const size_t sz = view_mmap_size(info.value_size, info.max_entries);
+	// PROT_READ only (array_map_kernel_user.cpp maps PROT_WRITE as well):
+	// the runtime must never write the view, and its probes run inside
+	// the traced program. MAP_SHARED: the kernel's writes are seen, and
+	// fork children (nginx workers, which drop privileges after the fork)
+	// keep reading the same pages.
+	void *p = mmap(nullptr, sz, PROT_READ, MAP_SHARED, fd, 0);
+	if (p == MAP_FAILED) {
+		snprintf(err, err_len, "mmap %zu bytes: %s", sz,
+			 strerror(errno));
+		return nullptr;
+	}
+	nslots = info.max_entries - 1;
+	char reason[160];
+	if (const char *bad = check_header((const tern_view_hdr *)p, nslots,
+					   reason, sizeof(reason))) {
+		snprintf(err, err_len, "%s", bad);
+		munmap(p, sz);
+		return nullptr;
+	}
+	return p;
+}
+#endif
+} // namespace
+
+extern "C" bool bpftime_view_setup(void)
+{
+	if (!bpftime_view_mode)
+		return false;
+	// One call per process image (the agent holds the result in a static).
+	static std::atomic<bool> ran{ false };
+	if (ran.exchange(true))
+		return __atomic_load_n(&bpftime_view_slots, __ATOMIC_RELAXED) !=
+		       nullptr;
+#if __linux__
+	const char *pin = getenv("BPFTIME_VIEW_PIN");
+	if (pin == nullptr || pin[0] == '\0')
+		pin = "/sys/fs/bpf/tern_view/view";
+	const char *id_file = getenv("BPFTIME_VIEW_ID_FILE");
+	char pin_err[160] = "", id_err[160] = "";
+	const char *via = "pin";
+	int fd = view_fd_from_pin(pin);
+	if (fd < 0) {
+		snprintf(pin_err, sizeof(pin_err), "BPF_OBJ_GET %s: %s", pin,
+			 strerror(errno));
+		// A container that does not see the host's bpffs can still
+		// reach the map by id (needs CAP_SYS_ADMIN: E5 targets and the
+		// nginx master run as root in a privileged container).
+		if (id_file != nullptr && id_file[0] != '\0') {
+			via = "id";
+			const uint32_t id =
+				read_id_file(id_file, id_err, sizeof(id_err));
+			if (id != 0) {
+				fd = view_fd_from_id(id);
+				if (fd < 0)
+					snprintf(id_err, sizeof(id_err),
+						 "BPF_MAP_GET_FD_BY_ID %u: %s",
+						 id, strerror(errno));
+			}
+		} else {
+			snprintf(id_err, sizeof(id_err),
+				 "no BPFTIME_VIEW_ID_FILE");
+		}
+	}
+	if (fd < 0) {
+		snprintf(view_status, sizeof(view_status),
+			 "not mapped: %s; %s", pin_err, id_err);
+		SPDLOG_WARN("View: {}", view_status);
+		return false;
+	}
+	uint32_t nslots = 0;
+	char map_err[200] = "";
+	const void *base = map_view(fd, nslots, map_err, sizeof(map_err));
+	// The mapping holds its own reference to the map.
+	close(fd);
+	if (base == nullptr) {
+		snprintf(view_status, sizeof(view_status),
+			 "not mapped (via %s): %s", via, map_err);
+		SPDLOG_WARN("View: {}", view_status);
+		return false;
+	}
+	publish(base, nslots);
+	snprintf(view_status, sizeof(view_status),
+		 "mapped %u slots via %s, self %s", nslots, via,
+		 self_hit() ? "hit" : "miss");
+	if (view_atfork_status != 0)
+		SPDLOG_WARN("View: fork handler not registered ({}); fork "
+			    "children report the parent's statistics",
+			    view_atfork_status);
+	return true;
+#else
+	snprintf(view_status, sizeof(view_status),
+		 "not mapped: unsupported platform");
+	SPDLOG_WARN("View: {}", view_status);
+	return false;
+#endif
+}
+
+extern "C" const char *bpftime_view_status(void)
+{
+	return view_status;
+}
+
+extern "C" bool bpftime_view_attach_for_test(void *base, uint32_t nslots)
+{
+	char reason[160];
+	if (base == nullptr ||
+	    check_header((const tern_view_hdr *)base, nslots, reason,
+			 sizeof(reason)) != nullptr)
+		return false;
+	publish(base, nslots);
+	return true;
+}
+
+extern "C" void bpftime_view_detach_for_test(void)
+{
+	__atomic_store_n(&bpftime_view_slots, (const tern_view_slot *)nullptr,
+			 __ATOMIC_RELEASE);
+	__atomic_store_n(&bpftime_view_mask, 0, __ATOMIC_RELEASE);
+	__atomic_store_n(&bpftime_view_reads, 0, __ATOMIC_RELAXED);
+	__atomic_store_n(&bpftime_view_misses, 0, __ATOMIC_RELAXED);
+}
diff --git a/runtime/src/kernel_view.hpp b/runtime/src/kernel_view.hpp
new file mode 100644
index 00000000..d1f9888f
--- /dev/null
+++ b/runtime/src/kernel_view.hpp
@@ -0,0 +1,173 @@
+#ifndef _BPFTIME_KERNEL_VIEW_HPP
+#define _BPFTIME_KERNEL_VIEW_HPP
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#if __linux__
+#include <linux/types.h>
+#endif
+#include "bpftime_view_abi.h"
+
+// Dview (P5a): a per-thread view of {tid, tgid, kuid, kgid, comm} kept by
+// kernel eBPF programs (tools/view, loaded by a privileged tern_viewd) in a
+// BPF_F_MMAPABLE array, which the runtime maps read-only. With the view,
+// bpf_get_current_uid_gid and bpf_get_current_comm answer what the kernel
+// helpers answer for the calling thread, including after changes the
+// careful interposers do not see (raw setresuid in one thread, writes to
+// /proc/<pid>/task/<tid>/comm), without a system call.
+//
+// Switch: BPFTIME_VIEW=1, read once at load (nginx clears its workers'
+// environment, which inherit this). The agent calls bpftime_view_setup()
+// once; only when it validated a live view are bpftime_view_slots and
+// bpftime_view_mask published. Off, or not mapped, each helper pays one load
+// of bpftime_view_slots and a branch.
+//
+// The view is keyed by the thread key the runtime already has (the careful
+// identity cache): uid/gid/comm are exact given a correct (tid, tgid). A
+// slot whose key differs, that is being written, that is STALE or that lacks
+// the requested valid bits is a miss, and the helper falls back to the exact
+// system call (never to a process-wide cache).
+
+static_assert(sizeof(struct tern_view_slot) == 64,
+	      "tern_view_slot is one cache line (ABI)");
+static_assert(sizeof(struct tern_view_hdr) == 64,
+	      "tern_view_hdr takes slot 0 (ABI)");
+static_assert(offsetof(struct tern_view_slot, comm) % 8 == 0,
+	      "comm is read as two 64-bit words");
+
+extern "C" {
+// BPFTIME_VIEW=1 at load. Default visibility, like bpftime_careful_mode.
+extern bool bpftime_view_mode;
+
+// Hidden: the runtime is linked into the agent (a shared object) and the
+// helpers read these on every call; a hidden global is one RIP-relative
+// load, a default-visibility one would add a GOT load. Each shared object
+// that links the runtime has its own copy.
+//
+// Slot array of the mapped view, already advanced past the header (slot
+// index 0), so that a thread's slot is bpftime_view_slots[tid & mask].
+// nullptr: no view in this process. Published once (mask first) and never
+// withdrawn while probes may run: the mapping stays until exec or exit.
+__attribute__((visibility("hidden"))) extern const struct tern_view_slot
+	*bpftime_view_slots;
+// nslots - 1 (nslots is a power of two). A reader that saw the slots but
+// an older mask (0) still indexes inside the array, and the key check
+// turns a wrong slot into a miss, so the two need no common lock.
+__attribute__((visibility("hidden"))) extern uint32_t bpftime_view_mask;
+// BPFTIME_VIEW_COUNT=1 at load: also count reads (a second read-modify-write
+// on the hot path, so off by default; misses are always counted).
+__attribute__((visibility("hidden"))) extern bool bpftime_view_count_reads;
+// Per process (cleared in fork children); reported at exit on stderr as
+// "View: reads <n|off> misses <m> pid <p>".
+__attribute__((visibility("hidden"))) extern uint64_t bpftime_view_reads;
+__attribute__((visibility("hidden"))) extern uint64_t bpftime_view_misses;
+
+// Called once by the agent (agent.cpp, after the careful setup). Off
+// (BPFTIME_VIEW unset): returns false and does nothing. On: gets a
+// read-only fd of the view (BPF_OBJ_GET of BPFTIME_VIEW_PIN, default
+// /sys/fs/bpf/tern_view/view; else BPF_MAP_GET_FD_BY_ID of the id in
+// BPFTIME_VIEW_ID_FILE), validates the map and its header, maps it with
+// PROT_READ and publishes it. Any failure logs a warning and leaves the view
+// off in this process; the helpers keep their paths. Raw bpf(2) only (no
+// libbpf), so that the build configuration of the runtime is unchanged.
+bool bpftime_view_setup(void);
+// One line for the agent's log: "off", "mapped <n> slots via pin|id, self
+// hit|miss", or "not mapped: <reason>". Valid after bpftime_view_setup.
+const char *bpftime_view_status(void);
+
+// Unit tests: publish a view at `base` (the header, followed by `nslots`
+// slots, nslots a power of two) after the same header checks as
+// bpftime_view_setup (magic, abi, nslots, state LIVE, pid namespace). No
+// kernel involved; the caller owns the memory. Returns whether published.
+bool bpftime_view_attach_for_test(void *base, uint32_t nslots);
+// Unit tests: withdraw the view (no reader may still use it).
+void bpftime_view_detach_for_test(void);
+}
+
+#if defined(__x86_64__) || defined(__i386__)
+#define BPFTIME_VIEW_CPU_RELAX() __builtin_ia32_pause()
+#elif defined(__aarch64__)
+#define BPFTIME_VIEW_CPU_RELAX() __asm__ __volatile__("yield" ::: "memory")
+#else
+#define BPFTIME_VIEW_CPU_RELAX() __asm__ __volatile__("" ::: "memory")
+#endif
+
+// comm is read as two 64-bit words through this type: char storage read
+// through a uint64_t lvalue would break strict aliasing.
+typedef uint64_t __attribute__((may_alias)) bpftime_view_u64_alias;
+
+// Reads the calling thread's slot (tid, tgid: init pid namespace ids).
+// `need`: valid bits required (TV_F_IDS | TV_F_CREDS for uid/gid,
+// TV_F_IDS | TV_F_COMM for comm). On a hit, fills uid/gid (if uid) and the
+// 16 bytes of comm (if comm) from one consistent snapshot and returns true.
+// Async-signal-safe: no lock, no system call, no allocation.
+//
+// Seqlock reader against the BPF writers (tools/view/view.bpf.c: cmpxchg
+// seq to odd, write, fetch_add to even): an even seq read with acquire, the
+// fields read with relaxed atomics, an acquire fence, then seq again. Equal
+// and even: the fields are one writer's complete update. A writer holding
+// the slot (odd seq) for four tries, or one that raced each try, is a miss:
+// writers hold a slot for a few dozen instructions, so waiting longer would
+// only add latency to a probe for a case the fallback answers exactly.
+static inline bool bpftime_view_read(uint32_t tid, uint32_t tgid,
+				     uint32_t need, uint32_t *uid,
+				     uint32_t *gid, char *comm)
+{
+	const tern_view_slot *v =
+		__atomic_load_n(&bpftime_view_slots, __ATOMIC_RELAXED);
+	if (v == nullptr)
+		return false;
+	const tern_view_slot *s =
+		&v[tid & __atomic_load_n(&bpftime_view_mask, __ATOMIC_RELAXED)];
+	for (int r = 0; r < 4; r++) {
+		const uint32_t q = __atomic_load_n(&s->seq, __ATOMIC_ACQUIRE);
+		if (q & 1) {
+			BPFTIME_VIEW_CPU_RELAX();
+			continue;
+		}
+		const uint32_t t = __atomic_load_n(&s->tid, __ATOMIC_RELAXED);
+		const uint32_t g = __atomic_load_n(&s->tgid, __ATOMIC_RELAXED);
+		const uint32_t f = __atomic_load_n(&s->flags, __ATOMIC_RELAXED);
+		const uint32_t u = __atomic_load_n(&s->uid, __ATOMIC_RELAXED);
+		const uint32_t gg = __atomic_load_n(&s->gid, __ATOMIC_RELAXED);
+		const bpftime_view_u64_alias *cw =
+			(const bpftime_view_u64_alias *)s->comm;
+		const uint64_t c0 = __atomic_load_n(&cw[0], __ATOMIC_RELAXED);
+		const uint64_t c1 = __atomic_load_n(&cw[1], __ATOMIC_RELAXED);
+		// Orders the field loads before the second seq load (a plain
+		// acquire load of seq would not keep earlier loads above it).
+		__atomic_thread_fence(__ATOMIC_ACQUIRE);
+		if (__atomic_load_n(&s->seq, __ATOMIC_RELAXED) != q)
+			continue;
+		// Another thread's slot (collision, a reused tid not yet
+		// rewritten), a slot the loader made STALE, or a slot without
+		// what was asked for: the exact path answers.
+		if (t != tid || g != tgid || (f & TV_F_STALE) ||
+		    (f & need) != need)
+			return false;
+		if (uid) {
+			*uid = u;
+			*gid = gg;
+		}
+		if (comm) {
+			memcpy(comm, &c0, 8);
+			memcpy(comm + 8, &c1, 8);
+		}
+		return true;
+	}
+	return false;
+}
+
+// Relaxed RMWs: per-process statistics, async-signal-safe.
+static inline void bpftime_view_count_read(void)
+{
+	if (__builtin_expect(bpftime_view_count_reads, 0))
+		__atomic_fetch_add(&bpftime_view_reads, 1, __ATOMIC_RELAXED);
+}
+
+static inline void bpftime_view_count_miss(void)
+{
+	__atomic_fetch_add(&bpftime_view_misses, 1, __ATOMIC_RELAXED);
+}
+
+#endif
