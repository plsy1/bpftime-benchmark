@@ -15,6 +15,23 @@
 namespace bpftime
 {
 
+void *per_cpu_array_map_impl::lookup_invalid_key()
+{
+	return ensure_on_current_cpu<void *>([](int) -> void * {
+		errno = ENOENT;
+		return nullptr;
+	});
+}
+
+void *per_cpu_array_map_impl::lookup_cpu_slot(uint8_t *entry_base,
+					   size_t cpu_stride)
+{
+	return ensure_on_current_cpu<void *>(
+		[entry_base, cpu_stride](int cpu) -> void * {
+			return entry_base + static_cast<size_t>(cpu) * cpu_stride;
+		});
+}
+
 per_cpu_array_map_impl::per_cpu_array_map_impl(
 	boost::interprocess::managed_shared_memory &memory, uint32_t value_size,
 	uint32_t max_entries, uint32_t ncpu)
