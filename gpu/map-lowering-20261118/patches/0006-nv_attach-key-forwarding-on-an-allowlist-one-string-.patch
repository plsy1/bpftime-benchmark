+			p.guarded = l.find('@') != std::string::npos;
+			// a label is an identifier before ':' that is not a guard
+			std::string nl = std::regex_replace(
+				l, std::regex(R"(@\s*!?\s*[%$A-Za-z_][\w$]*)"), " ");
