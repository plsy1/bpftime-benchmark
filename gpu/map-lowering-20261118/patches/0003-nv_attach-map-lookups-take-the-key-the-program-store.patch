 			  << n << ", " << d.max_entries << ";\n"
 			  << "\tmul.wide.u32 \t%bptl_a" << n << ", %bptl_k"
diff --git a/attach/nv_attach_impl/nv_thread_local_routing.hpp b/attach/nv_attach_impl/nv_thread_local_routing.hpp
index 559a5072..3629ea97 100644
--- a/attach/nv_attach_impl/nv_thread_local_routing.hpp
+++ b/attach/nv_attach_impl/nv_thread_local_routing.hpp
@@ -34,6 +34,13 @@ struct thread_local_map_desc {
