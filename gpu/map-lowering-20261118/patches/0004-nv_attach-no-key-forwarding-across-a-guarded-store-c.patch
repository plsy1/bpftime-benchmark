From 1fee25d1b9d436ee19ed8149f7d1a21998586848 Mon Sep 17 00:00:00 2001
From: jetson <jetson@orin-nano.tail52323b.ts.net>
Date: Wed, 18 Nov 2026 08:26:19 +0900
Subject: [PATCH 4/5] nv_attach: no key forwarding across a guarded store,
 call, atomic or reduction

A store under a predicate may not have run, so the slot can still hold an
older key: forwarded_key now reads the statements with their guards and
gives up at any guarded store, call, atom or red between the slot's store
and the lookup (or a guarded store as that store). llvmbpf emits none of
these today: lat_mmvq's generated PTX is byte-identical before and after
(sha256 41b5bf76...), so passes k1-k3 stand. Tests: three guarded cases.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../nv_thread_local_routing.cpp               | 20 ++++++++++++++++---
 .../test/test_sum_map_routing.cpp             |  5 +++++
 2 files changed, 22 insertions(+), 3 deletions(-)

diff --git a/attach/nv_attach_impl/nv_thread_local_routing.cpp b/attach/nv_attach_impl/nv_thread_local_routing.cpp
index c0631afb..fc0a29e5 100644
--- a/attach/nv_attach_impl/nv_thread_local_routing.cpp
+++ b/attach/nv_attach_impl/nv_thread_local_routing.cpp
@@ -120,11 +120,15 @@ bool parse_int(const std::string &s, long long *v)
 // leading braces, labels and a guard predicate stripped. Directives without
 // a ';' (.loc, .file) stay glued to the statement after them; count_defs
 // then counts that statement if it mentions the register at all.
-std::vector<std::string> statements(const std::string &body)
+std::vector<std::string> statements(const std::string &body,
+				    bool keep_guards = false)
 {
 	static const std::regex comment(R"(//[^\n]*|/\*[\s\S]*?\*/)");
 	static const std::regex lead(
 		R"(^(?:\s|[{}]|[$A-Za-z_][\w$]*\s*:(?!:)|@\s*!?\s*%[\w$]+)+)");
+	// labels and braces only: a guard stays at the front
+	static const std::regex lead_kept(
+		R"(^(?:\s|[{}]|[$A-Za-z_][\w$]*\s*:(?!:))+)");
 	std::string text = std::regex_replace(body, comment, "");
 	std::vector<std::string> out;
 	size_t start = 0;
@@ -133,7 +137,7 @@ std::vector<std::string> statements(const std::string &body)
 		std::string st = text.substr(
 			start, semi == std::string::npos ? std::string::npos :
 							   semi - start);
-		st = std::regex_replace(st, lead, "");
+		st = std::regex_replace(st, keep_guards ? lead_kept : lead, "");
 		out.push_back(trim(st));
 		if (semi == std::string::npos)
 			break;
@@ -269,13 +273,23 @@ std::string forwarded_key(const std::string &fbody, size_t call_at,
 					    label);
 	     it != std::sregex_iterator(); ++it)
 		from = it->position(0) + it->length(0);
-	const auto sts = statements(before.substr(from));
+	// guards kept: a store under a predicate may not have run
+	const auto sts = statements(before.substr(from), true);
 	static const std::regex store(
 		R"(^st(\.local)?\.[ubs](8|16|32|64)\s+\[\s*(%[\w$]+)\s*(?:\+\s*(-?\d+))?\s*\]\s*,\s*(%[\w$]+|-?\d+)\s*$)");
 	for (int i = (int)sts.size() - 1; i >= 0; i--) {
 		const std::string &st = sts[i];
 		if (st.empty() || st[0] == '.')
 			continue;
+		if (st[0] == '@') {
+			// a guarded instruction: a store under it may or may not
+			// have written the slot
+			static const std::regex guarded_store(
+				R"(^@\s*!?\s*%[\w$]+\s+(st|call|atom|red)\b)");
+			if (std::regex_search(st, guarded_store))
+				return "";
+			continue;
+		}
 		const std::string op = st.substr(0, st.find_first_of(" \t\n"));
 		if (op.rfind("call", 0) == 0 || op.rfind("atom", 0) == 0 ||
 		    op.rfind("red", 0) == 0)
diff --git a/attach/nv_attach_impl/test/test_sum_map_routing.cpp b/attach/nv_attach_impl/test/test_sum_map_routing.cpp
index 086cbefa..062988da 100644
--- a/attach/nv_attach_impl/test/test_sum_map_routing.cpp
+++ b/attach/nv_attach_impl/test/test_sum_map_routing.cpp
@@ -384,6 +384,11 @@ TEST_CASE("A key that may have changed since its store is loaded again",
 		FRAME + STORE + "\tadd.s32 \t%r7, %r7, 1;\n",
 		// an atomic in between
 		FRAME + STORE + "\tatom.add.u32 \t%r9, [%rd77], 1;\n",
+		// the store under a predicate (it may not have run)
+		FRAME + "\t@%p3 st.local.u32 \t[%rd1+504], %r7;\n",
+		FRAME + "\t@!%p3 st.local.u32 \t[%rd1+504], %r7;\n",
+		// a guarded store after the key's store
+		FRAME + STORE + "\t@%p3 st.local.u32 \t[%rd1+504], %r8;\n",
 		// no store at all
 		FRAME,
 		// a frame that is not llvmbpf's
