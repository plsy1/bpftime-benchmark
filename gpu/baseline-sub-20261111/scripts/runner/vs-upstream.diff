+
+# Upstream waits a fixed 10 s for the probe loader before starting the victim
+# (about 60 of 65 minutes of a 10-round, 24-case dev-vs-dev comparison). This
+# copy (bpftime-gpu-work/compare/runner) starts the victim once the loader is
+# ready instead, and never later than upstream:
+# - the micro loader prints "BPF probes attached" after its skeleton attach;
+# - the example loaders print no ready line: the syscall server logs
+#   "Created kprobe/kretprobe perf event handler" for each probe's perf event,
+#   and libbpf's attach follows at once; ready when the loader prints its own
+#   output after such a line (cuda-counter's per-second line), or when the log
+#   has been quiet for SETTLE seconds after it;
+# - the loader exiting ends the wait (the case then fails as upstream's would).
+READY_MARKERS = ("BPF probes attached",)
+PERF_EVENT_MARKER = "Created kprobe/kretprobe perf event handler"
+SETTLE = 1.0
+
+
+def wait_probe_ready(probe_log, probe_process, limit):
+    start = time.monotonic()
+    last_size, last_change = -1, start
+    while True:
+        now = time.monotonic()
+        if now - start >= limit:
+            return now - start, "limit"
+        if probe_process.poll() is not None:
+            return now - start, f"loader exited ({probe_process.returncode})"
+        try:
+            with open(probe_log, "r", errors="replace") as f:
+                text = f.read()
+        except OSError:
+            text = ""
+        if any(m in text for m in READY_MARKERS):
+            return now - start, "ready line"
+        if PERF_EVENT_MARKER in text:
+            after = text[text.rfind(PERF_EVENT_MARKER):].split("\n")[1:]
+            # the loader's own output after the last perf event (its main
+            # loop runs, e.g. cuda-counter's per-second line): attached
+            if any(l.strip() and not l.startswith(("libbpf:", "["))
+                   for l in after[:-1]):
+                return now - start, "loader output after attach"
+        if len(text) != last_size:
+            last_size, last_change = len(text), now
+        elif PERF_EVENT_MARKER in text and now - last_change >= SETTLE:
+            return now - start, "perf events created, log quiet"
+        time.sleep(0.05)
+
