// (a) form 3: a helper returning the generic address of a .local in its own
// frame. Accepted by ptxas; the frame ends when the helper returns.
.version 8.1
.target sm_87
.address_size 64
.visible .func (.param .b64 r) getframe()
{
	.reg .b64 %rd<2>;
	{
	.local .align 8 .b8 fb[64];
	cvta.local.u64 %rd1, fb;
	}
	st.param.b64 [r], %rd1;
	ret;
}
.visible .entry k(.param .u64 k_p0)
{
	.reg .b64 %rd<4>;
	{ .param .b64 rv; call (rv), getframe, (); ld.param.b64 %rd1, [rv]; }
	mov.u64 %rd2, %globaltimer;
	st.u64 [%rd1], %rd2;
	ld.param.u64 %rd3, [k_p0];
	st.global.u64 [%rd3], %rd2;
	ret;
}
