// (a) form 2: module-scope .local and a function returning its generic address.
// PTX ISA 5.1.5: with the ABI, .local variables must be declared in function scope.
.version 8.1
.target sm_87
.address_size 64
.local .align 16 .b8 __c1_carry_mod[16];
.visible .func (.param .b64 r) getc()
{
	.reg .b64 %rd<2>;
	cvta.local.u64 %rd1, __c1_carry_mod;
	st.param.b64 [r], %rd1;
	ret;
}
.visible .entry k(.param .u64 k_p0)
{
	.reg .b64 %rd<4>;
	{ .param .b64 rv; call (rv), getc, (); ld.param.b64 %rd1, [rv]; }
	mov.u64 %rd2, %globaltimer;
	st.u64 [%rd1], %rd2;
	ld.param.u64 %rd3, [k_p0];
	st.global.u64 [%rd3], %rd2;
	ret;
}
