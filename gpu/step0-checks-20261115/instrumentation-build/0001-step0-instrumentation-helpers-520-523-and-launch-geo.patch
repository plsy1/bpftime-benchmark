+// step0 instrumentation (experiment only): read-only ids for the GPU map
+// design study. 520: the lanes of the warp executing this call
+// (activemask); 521: %gridid (u64, per-context launch number); 522: %nsmid;
+// 523: %nwarpid.
+extern "C" __noinline__ __device__ uint64_t
+_bpf_helper_ext_0520(uint64_t, uint64_t, uint64_t, uint64_t, uint64_t)
+{
+    uint32_t mask;
+    asm volatile("activemask.b32 %0;" : "=r"(mask));
+    return (uint64_t)mask;
+}
+
+extern "C" __noinline__ __device__ uint64_t
+_bpf_helper_ext_0521(uint64_t, uint64_t, uint64_t, uint64_t, uint64_t)
+{
+    uint64_t grid_id;
+    asm volatile("mov.u64 %0, %%gridid;" : "=l"(grid_id));
+    return grid_id;
+}
+
+extern "C" __noinline__ __device__ uint64_t
+_bpf_helper_ext_0522(uint64_t, uint64_t, uint64_t, uint64_t, uint64_t)
+{
+    uint32_t nsmid;
+    asm volatile("mov.u32 %0, %%nsmid;" : "=r"(nsmid));
+    return (uint64_t)nsmid;
+}
+
+extern "C" __noinline__ __device__ uint64_t
+_bpf_helper_ext_0523(uint64_t, uint64_t, uint64_t, uint64_t, uint64_t)
+{
+    uint32_t nwarpid;
+    asm volatile("mov.u32 %0, %%nwarpid;" : "=r"(nwarpid));
+    return (uint64_t)nwarpid;
+}
