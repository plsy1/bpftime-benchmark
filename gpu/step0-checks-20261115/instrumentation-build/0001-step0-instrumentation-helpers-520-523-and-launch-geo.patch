+// ---------------------------------------------------------------------------
+// step0 instrumentation (experiment only): launch geometry log.
+// With BPFTIME_EXP_GEOMETRY_LOG naming a file, every launch-related hook below
+// appends one tab-separated line at its entry, before any early return:
+//   ns tid depth hook name ptr gx gy gz bx by bz shmem capturing stream graph
+//   node
+// ns: CLOCK_MONOTONIC; depth: other logged hooks active on this thread (a
+// redirect from cudaLaunchKernel to cuLaunchKernel logs depth 1); name: the
+// mangled kernel name (cuFuncGetName; runtime pointers through
+// cudaGetFuncBySymbol, else cuKernelGetName for a CUDA 13 kernel handle),
+// "?" when unknown (not cached when the application had a cudart error
+// pending, which the lookup must not clear); capturing: 1/0, "-" without a
+// stream, "e<code>" when the query failed. Without the variable nothing
+// changes.
+namespace
+{
+struct exp_geometry_log {
+	int fd = -1;
+	std::mutex mutex; // the write and the name cache
+	std::unordered_map<const void *, std::string> names;
+};
+
+exp_geometry_log *exp_geometry_log_get()
+{
+	static exp_geometry_log *log = []() -> exp_geometry_log * {
+		const char *path = getenv("BPFTIME_EXP_GEOMETRY_LOG");
+		if (path == nullptr || path[0] == '\0')
+			return nullptr;
+		int fd = open(path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC,
+			      0644);
+		if (fd < 0)
+			return nullptr;
+		auto *l = new exp_geometry_log;
+		l->fd = fd;
+		std::string header =
+			"# bpftime-exp-geometry v1 pid=" +
+			std::to_string((long)getpid()) +
+			"\n# ns\ttid\tdepth\thook\tname\tptr\tgx\tgy\tgz\tbx\tby\tbz\tshmem\tcapturing\tstream\tgraph\tnode\n";
+		(void)!write(fd, header.data(), header.size());
+		return l;
+	}();
+	return log;
+}
+
+thread_local int exp_geometry_depth = 0;
+
+std::string exp_hex(const void *p)
+{
+	char buf[32];
+	snprintf(buf, sizeof(buf), "%lx", (unsigned long)(uintptr_t)p);
+	return buf;
+}
+
+std::optional<std::string> exp_cached_name(exp_geometry_log &log,
+					   const void *key)
+{
+	std::lock_guard<std::mutex> guard(log.mutex);
+	if (auto it = log.names.find(key); it != log.names.end())
+		return it->second;
+	return std::nullopt;
+}
+
+void exp_cache_name(exp_geometry_log &log, const void *key,
+		    const std::string &name)
+{
+	std::lock_guard<std::mutex> guard(log.mutex);
+	log.names.emplace(key, name);
+}
+
+std::string exp_name_of_cufunction(exp_geometry_log &log, CUfunction f)
+{
+	if (f == nullptr)
+		return "?";
+	if (auto cached = exp_cached_name(log, f); cached)
+		return *cached;
+	using fn_t = CUresult (*)(const char **, CUfunction);
+	static fn_t get = (fn_t)dlsym(RTLD_DEFAULT, "cuFuncGetName");
+	const char *name = nullptr;
+	std::string out = "?";
+	if (get && get(&name, f) == CUDA_SUCCESS && name && name[0])
+		out = name;
+	// since CUDA 12 a CUkernel may stand where a CUfunction is expected
+	using kfn_t = CUresult (*)(const char **, CUkernel);
+	static kfn_t kget = (kfn_t)dlsym(RTLD_DEFAULT, "cuKernelGetName");
+	name = nullptr;
+	if (out == "?" && kget &&
+	    kget(&name, reinterpret_cast<CUkernel>(f)) == CUDA_SUCCESS && name &&
+	    name[0])
+		out = name;
+	exp_cache_name(log, f, out);
+	return out;
+}
+
+std::string exp_name_of_cukernel(exp_geometry_log &log, CUkernel k)
+{
+	if (k == nullptr)
+		return "?";
+	if (auto cached = exp_cached_name(log, k); cached)
+		return *cached;
+	using fn_t = CUresult (*)(const char **, CUkernel);
+	static fn_t get = (fn_t)dlsym(RTLD_DEFAULT, "cuKernelGetName");
+	const char *name = nullptr;
+	std::string out = "?";
+	if (get && get(&name, k) == CUDA_SUCCESS && name && name[0])
+		out = name;
+	exp_cache_name(log, k, out);
+	return out;
+}
+
+// A runtime-API function pointer: a host stub or a CUDA 13 kernel handle
+// (nvcc 13's default launch passes the handle through __cudaLaunchKernel,
+// which branches to cudaLaunchKernel).
+std::string exp_name_of_runtime_function(exp_geometry_log &log,
+					 const void *func)
+{
+	if (func == nullptr)
+		return "?";
+	if (auto cached = exp_cached_name(log, func); cached)
+		return *cached;
+	// as note_launch_if_probed: never clear an error of the application's
+	if (cudaPeekAtLastError() != cudaSuccess)
+		return "?";
+	std::string out = "?";
+	cudaFunction_t f = nullptr;
+	if (cudaGetFuncBySymbol(&f, func) == cudaSuccess && f != nullptr) {
+		out = exp_name_of_cufunction(log, reinterpret_cast<CUfunction>(f));
+	} else {
+		(void)cudaGetLastError();
+		if (!elf_introspect::module_containing((std::uintptr_t)func))
+			out = exp_name_of_cukernel(
+				log, reinterpret_cast<CUkernel>(
+					     const_cast<void *>(func)));
+	}
+	exp_cache_name(log, func, out);
+	return out;
+}
+
+std::string exp_capturing_of(CUstream stream)
+{
+	CUstreamCaptureStatus status = CU_STREAM_CAPTURE_STATUS_NONE;
+	CUresult err = cuStreamIsCapturing(stream, &status);
+	if (err != CUDA_SUCCESS)
+		return "e" + std::to_string((int)err);
+	return status == CU_STREAM_CAPTURE_STATUS_NONE ? "0" : "1";
+}
+
+// Logs at construction (when enabled) and marks this thread inside a logged
+// hook until destruction.
+struct exp_geometry_scope {
+	bool active = false;
+	exp_geometry_scope(const char *hook, const std::string &name,
+			   const void *ptr, unsigned gx, unsigned gy,
+			   unsigned gz, unsigned bx, unsigned by, unsigned bz,
+			   unsigned long long shmem,
+			   const std::string &capturing, const void *stream,
+			   const void *graph, const void *node)
+	{
+		auto *log = exp_geometry_log_get();
+		if (log == nullptr)
+			return;
+		active = true;
+		struct timespec ts;
+		clock_gettime(CLOCK_MONOTONIC, &ts);
+		static thread_local long tid = (long)syscall(SYS_gettid);
+		std::string line;
+		line.reserve(256 + name.size());
+		line += std::to_string((long long)ts.tv_sec * 1000000000LL +
+				       ts.tv_nsec);
+		line += '\t';
+		line += std::to_string(tid);
+		line += '\t';
+		line += std::to_string(exp_geometry_depth);
+		line += '\t';
+		line += hook;
+		line += '\t';
+		line += name;
+		line += '\t';
+		line += exp_hex(ptr);
+		for (unsigned v : { gx, gy, gz, bx, by, bz }) {
+			line += '\t';
+			line += std::to_string(v);
+		}
+		line += '\t';
+		line += std::to_string(shmem);
+		line += '\t';
+		line += capturing;
+		line += '\t';
+		line += stream == nullptr ? std::string("0") : exp_hex(stream);
+		line += '\t';
+		line += graph == nullptr ? std::string("-") : exp_hex(graph);
+		line += '\t';
+		line += node == nullptr ? std::string("-") : exp_hex(node);
+		line += '\n';
+		std::lock_guard<std::mutex> guard(log->mutex);
+		const char *p = line.data();
+		size_t left = line.size();
+		while (left > 0) {
+			ssize_t n = write(log->fd, p, left);
+			if (n < 0 && errno == EINTR)
+				continue;
+			if (n <= 0)
+				break;
+			p += n;
+			left -= (size_t)n;
+		}
+		exp_geometry_depth++;
+	}
+	~exp_geometry_scope()
+	{
+		if (active)
+			exp_geometry_depth--;
+	}
+	exp_geometry_scope(const exp_geometry_scope &) = delete;
+	exp_geometry_scope &operator=(const exp_geometry_scope &) = delete;
+};
+
+// The runtime launch hooks' entry line.
+#define EXP_LOG_RUNTIME_LAUNCH(hook, func, grid_dim, block_dim, shared_mem,     \
+			       stream)                                         \
+	std::optional<exp_geometry_scope> exp_scope;                           \
+	if (auto *exp_log = exp_geometry_log_get(); exp_log != nullptr)        \
+		exp_scope.emplace(                                             \
+			hook,                                                  \
+			exp_name_of_runtime_function(*exp_log, func),          \
+			func, grid_dim.x, grid_dim.y, grid_dim.z, block_dim.x, \
+			block_dim.y, block_dim.z,                              \
+			(unsigned long long)shared_mem,                        \
+			exp_capturing_of(reinterpret_cast<CUstream>(stream)),  \
+			(const void *)stream, nullptr, nullptr)
+
+template <class Params>
+void exp_log_graph_params_v1(std::optional<exp_geometry_scope> &scope,
+			     const char *hook, const Params *params,
+			     const void *graph, const void *node)
+{
+	auto *log = exp_geometry_log_get();
+	if (log == nullptr)
+		return;
+	if (params == nullptr) {
+		scope.emplace(hook, "?", nullptr, 0, 0, 0, 0, 0, 0, 0ULL, "-",
+			      nullptr, graph, node);
+		return;
+	}
+	scope.emplace(hook, exp_name_of_cufunction(*log, params->func),
+		      (const void *)params->func, params->gridDimX,
+		      params->gridDimY, params->gridDimZ, params->blockDimX,
+		      params->blockDimY, params->blockDimZ,
+		      (unsigned long long)params->sharedMemBytes, "-", nullptr,
+		      graph, node);
+}
+
+void exp_log_graph_params_v2(std::optional<exp_geometry_scope> &scope,
+			     const char *hook,
+			     const CUDA_KERNEL_NODE_PARAMS_v2 *params,
+			     const void *graph, const void *node)
+{
+	auto *log = exp_geometry_log_get();
+	if (log == nullptr)
+		return;
+	if (params == nullptr) {
+		scope.emplace(hook, "?", nullptr, 0, 0, 0, 0, 0, 0, 0ULL, "-",
+			      nullptr, graph, node);
+		return;
+	}
+	std::string name = "?";
+	const void *ptr = nullptr;
+	if (params->func != nullptr) {
+		name = exp_name_of_cufunction(*log, params->func);
+		ptr = params->func;
+	} else if (params->kern != nullptr) {
+		name = exp_name_of_cukernel(*log, params->kern);
+		ptr = params->kern;
+	}
+	scope.emplace(hook, name, ptr, params->gridDimX, params->gridDimY,
+		      params->gridDimZ, params->blockDimX, params->blockDimY,
+		      params->blockDimZ,
+		      (unsigned long long)params->sharedMemBytes, "-", nullptr,
+		      graph, node);
+}
+} // namespace
