--- run_one.sh.pre-dvfs	2026-11-12 21:10:35.761648193 +0900
+++ run_one.sh	2026-11-12 21:10:35.785648977 +0900
@@ -44,12 +44,27 @@
 }
 hm=$(date +%H%M); if [ "$hm" -ge 0325 ] && [ "$hm" -le 0415 ]; then echo "ABORT: window"; exit 2; fi
 cpu=$(cat /sys/devices/system/cpu/cpu5/cpufreq/scaling_cur_freq); gpu=$(cat /sys/class/devfreq/17000000.gpu/cur_freq)
-[ "$cpu" = 1728000 ] && [ "$gpu" = 1020000000 ] || { echo "ABORT: clocks $cpu $gpu"; exit 2; }
+CLOCKS=${CLOCKS:-on}   # on: jetson_clocks (every earlier round); off: clocks.sh's off regime
+case $CLOCKS in
+  on) [ "$cpu" = 1728000 ] && [ "$gpu" = 1020000000 ] || { echo "ABORT: clocks $cpu $gpu"; exit 2; };;
+  off) $G/policy/clocks.sh check-off || { echo "ABORT: clocks not in the off regime"; exit 2; };;
+  *) echo "bad CLOCKS"; exit 2;;
+esac
+# residency counters around the victims: cpufreq time_in_state (10 ms units), cpuidle usage/time
+# (us), GPU and EMC devfreq trans_stat
+resid() {
+  { echo "== $1 $(date +%s%N)"
+    for p in /sys/devices/system/cpu/cpufreq/policy*; do echo "## cpufreq ${p##*/}"; cat $p/stats/time_in_state; done
+    for c in /sys/devices/system/cpu/cpu[0-9]*; do for s in $c/cpuidle/state[0-9]*; do echo "idle ${c##*/} $(cat $s/name) $(cat $s/usage) $(cat $s/time)"; done; done
+    echo "## gpu"; cat /sys/class/devfreq/17000000.gpu/trans_stat
+    echo "## emc"; cat /sys/class/devfreq/bwmgr/trans_stat 2>/dev/null
+  } >> $O.resid
+}
