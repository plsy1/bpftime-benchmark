 // How often a watcher in WFE checks whether the probed kernels have ended.
 constexpr auto cuda_watcher_kernel_check = std::chrono::microseconds(100);
+
+// Experiment exp/watcher-policy (not for dev). BPFTIME_CUDA_WATCHER_POLICY holds
+// letters: A parks the watcher on the launch note while no probed kernel is in
+// flight (1 ms backstop) and sleeps 100 us while one is; C replaces the fixed
+// 200 us poll after a request with a hot window sized from request gaps (KVM
+// halt-poll grow/shrink, capped per episode) and K short sleeps (NAPI deferral);
+// B waits with WFE instead of sleeping while a core is spare (/proc/loadavg
+// running count) and latches back to sleeping after it was kept waiting
+// (run_delay or a late WFE return). Timer slack 1 us. Counters go to the file
+// BPFTIME_CUDA_WATCHER_STATS at exit.
+struct policy_stats {
+	uint64_t req = 0, hot_iters = 0, defer_sleeps = 0, slow_sleeps = 0,
+		 wfe_waits = 0, parks = 0, park_timeouts = 0, unseen_latch = 0,
+		 evq = 0, gate_checks = 0, gate_open_checks = 0, gate_opens = 0,
+		 latch_trips = 0, cap_forced = 0, guard_skips = 0,
+		 unseen_hits = 0;
+	uint64_t us_hot = 0, us_defer = 0, us_slow = 0, us_slow_wfe = 0,
+		 us_park = 0;
+	uint64_t win_hist[4] = {};
+};
+
+inline uint64_t policy_now_us()
+{
+	timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t)ts.tv_sec * 1000000ull + (uint64_t)ts.tv_nsec / 1000;
+}
+
+template <class Flag>
+void run_policy_watcher(cuda::CUDAContext *ctx, Flag &stop,
+			const std::string &policy)
+{
+	const bool A = policy.find('A') != std::string::npos;
+	const bool C = policy.find('C') != std::string::npos;
+	const bool B = policy.find('B') != std::string::npos &&
+		       cuda_watcher_can_wait_on_flag();
+	auto env_u64 = [](const char *n, uint64_t d) -> uint64_t {
+		const char *v = getenv(n);
+		return v && *v ? strtoull(v, nullptr, 10) : d;
+	};
+	constexpr uint64_t P_SLOW = 100, BACKSTOP = 1000, EVQ_EVERY = 1000;
+	// controls: the busy poll after a request (A, B) and the deferral sleeps (C)
+	const uint64_t HOT_US = env_u64("BPFTIME_CUDA_WATCHER_HOT_US", 200);
+	constexpr uint64_t WIN_START = 10, WIN_MAX = 300, EPISODE_CAP = 1000,
+			   P_DEFER = 20, P_MIN = 10;
+	const int K_DEFER = (int)env_u64("BPFTIME_CUDA_WATCHER_K_DEFER", 8);
+	constexpr uint64_t CHECK_US = 1000, RD_TRIP_NS = 200000,
+			   LATE_WFE_US = 500;
+	constexpr int OPEN_STREAK = 3, SPARE = 1;
+	constexpr double LATE_GUARD_US = 30;
+	auto &activity = attach::launch_activity();
+	policy_stats st;
+	prctl(PR_SET_TIMERSLACK, 1000);
+	SPDLOG_INFO("CUDA watcher (experiment): policy {} (A={} B={} C={})",
+		    policy, A, B, C);
+	auto *comm = ctx->cuda_shared_mem;
+	uint64_t last_req = 0, last_detect = 0;
+	uint64_t seen_gen = activity.generation();
+	bool inflight = false, unseen = false;
+	int unseen_run = 0;
+	uint64_t t_evq = 0;
+	double late_ewma = 0;
+	uint64_t win = 0, hot_since = 0;
+	int k = 0;
+	bool in_hot = false, forced_cool = false;
+	int fd_la = -1, fd_sd = -1;
+	long ncpu = 6;
+	bool gate = false, nonspin = false;
+	int open_streak = 0;
+	uint64_t t_chk = 0, rd_prev = 0, nonspin_gen = 0;
+	if (B) {
+		fd_la = open("/proc/loadavg", O_RDONLY | O_CLOEXEC);
+		fd_sd = open("/proc/thread-self/schedstat", O_RDONLY | O_CLOEXEC);
+		cpu_set_t cs;
+		CPU_ZERO(&cs);
+		if (sched_getaffinity(0, sizeof(cs), &cs) == 0)
+			ncpu = CPU_COUNT(&cs);
+	}
+	auto sleep_us = [&](uint64_t n) {
+		uint64_t t0 = policy_now_us();
+		timespec ts{ 0, (long)(n * 1000) };
+		clock_nanosleep(CLOCK_MONOTONIC, 0, &ts, nullptr);
+		double late = (double)(policy_now_us() - t0) - (double)n - 4.0;
+		late_ewma += (late - late_ewma) / 8.0;
+	};
+	auto try_serve = [&]() -> bool {
+		int posted = 1;
+		if (__atomic_load_n(&comm->flag1, __ATOMIC_RELAXED) == 1 &&
+		    __atomic_compare_exchange_n(&comm->flag1, &posted, 0, false,
+						__ATOMIC_ACQUIRE,
+						__ATOMIC_RELAXED)) {
+			uint64_t t = policy_now_us();
+			serve_cuda_request(ctx);
+			__atomic_store_n(&comm->flag2, 1, __ATOMIC_RELEASE);
+			st.req++;
+			if (C) {
+				uint64_t gap = last_req ? t - last_req :
+							  UINT64_MAX;
+				if (gap <= win) {
+				} else if (gap < WIN_MAX)
+					win = std::min(std::max(2 * win,
+								WIN_START),
+						       WIN_MAX);
+				else
+					win = 0;
+				st.win_hist[win == 0	    ? 0 :
+					    win <= 20 ? 1 :
+					    win <= 80 ? 2 :
+							3]++;
+				k = K_DEFER;
+			}
+			last_detect = t;
+			last_req = policy_now_us();
+			return true;
+		}
+		return false;
+	};
+	auto kernels_inflight = [&](uint64_t t) -> bool {
+		if (!A || unseen)
+			return true;
+		uint64_t g = activity.generation();
+		if (g != seen_gen) {
+			seen_gen = g;
+			inflight = true;
+			t_evq = t;
+			return true;
+		}
+		if (inflight && t - t_evq >= EVQ_EVERY) {
+			inflight = activity.any_running();
+			t_evq = t;
+			st.evq++;
+		}
+		return inflight;
+	};
+	auto gate_check = [&](uint64_t t) -> bool {
+		if (t_chk && t - t_chk < CHECK_US)
+			return gate;
+		const bool long_gap = t_chk && t - t_chk > 2 * CHECK_US;
+		t_chk = t;
+		st.gate_checks++;
+		char buf[160];
+		long others = ncpu;
+		ssize_t n = pread(fd_la, buf, sizeof(buf) - 1, 0);
+		if (n > 0) {
+			buf[n] = 0;
+			char *p = buf;
+			for (int i = 0; i < 3 && p; i++) {
+				p = strchr(p, ' ');
+				if (p)
+					p++;
+			}
+			if (p)
+				others = atol(p) - 1;
+		}
+		n = pread(fd_sd, buf, sizeof(buf) - 1, 0);
+		if (n > 0) {
+			buf[n] = 0;
+			char *p = strchr(buf, ' ');
+			if (p) {
+				uint64_t rd = strtoull(p + 1, nullptr, 10);
+				if (rd_prev && !long_gap &&
+				    rd - rd_prev > RD_TRIP_NS) {
+					if (!nonspin)
+						st.latch_trips++;
+					nonspin = true;
+					nonspin_gen = activity.generation();
+				}
+				rd_prev = rd;
+			}
+		}
+		bool was = gate;
+		if (others >= ncpu - 1) {
+			gate = false;
+			open_streak = 0;
+		} else if (others <= ncpu - 1 - SPARE) {
+			if (++open_streak >= OPEN_STREAK)
+				gate = true;
+		}
+		if (nonspin) {
+			if (gate && activity.generation() != nonspin_gen)
+				nonspin = false;
+			else
+				gate = false;
+		}
+		if (gate)
+			st.gate_open_checks++;
+		if (gate && !was)
+			st.gate_opens++;
+		return gate;
+	};
+	auto wfe_wait = [&]() {
+		uint64_t t0 = policy_now_us();
+		wait_while_equal(&comm->flag1, 0);
+		st.wfe_waits++;
+		if (policy_now_us() - t0 > LATE_WFE_US) {
+			if (!nonspin)
+				st.latch_trips++;
+			nonspin = true;
+			nonspin_gen = activity.generation();
+			gate = false;
+		}
+	};
+
+	while (!stop->load(std::memory_order_acquire)) {
+		if (try_serve())
+			continue;
+		uint64_t t = policy_now_us();
+		if (!C) {
+			if (last_req && t - last_req < HOT_US) {
+				if (B && gate_check(t))
+					wfe_wait();
+				else
+					cpu_relax();
+				st.hot_iters++;
+				st.us_hot += policy_now_us() - t;
+				continue;
+			}
+		} else {
+			if (win && last_req && t - last_req < win &&
+			    !forced_cool) {
+				if (!in_hot) {
+					in_hot = true;
+					hot_since = t;
+				}
+				if (t - hot_since > EPISODE_CAP) {
+					forced_cool = true;
+					st.cap_forced++;
+				} else {
+					if (B && gate_check(t))
+						wfe_wait();
+					else if (B)
+						sleep_us(P_MIN);
+					else
+						cpu_relax();
+					st.hot_iters++;
+					st.us_hot += policy_now_us() - t;
+					continue;
+				}
+			}
+			in_hot = false;
+			if (k > 0) {
+				if (late_ewma > LATE_GUARD_US) {
+					k = 0;
+					st.guard_skips++;
+				} else {
+					sleep_us(P_DEFER);
+					k--;
+					forced_cool = false;
+					st.defer_sleeps++;
+					st.us_defer += policy_now_us() - t;
+					continue;
+				}
+			}
+			forced_cool = false;
+		}
+		if (!kernels_inflight(t)) {
+			if (try_serve())
+				continue;
+			st.parks++;
+			const uint64_t g0 = seen_gen;
+			activity.wait_for_note(seen_gen,
+					       std::chrono::microseconds(BACKSTOP));
+			const uint64_t waited = policy_now_us() - t;
+			st.us_park += waited;
+			// a request after a full backstop with no launch noted:
+			// launches the hooks do not see (graphs); twice -> stop
+			// parking for good
+			if (activity.generation() == g0 && waited >= BACKSTOP) {
+				st.park_timeouts++;
+				if (__atomic_load_n(&comm->flag1,
+						    __ATOMIC_ACQUIRE) == 1) {
+					st.unseen_hits++;
+					if (++unseen_run >= 2 && !unseen) {
+						unseen = true;
+						st.unseen_latch++;
+					}
+				}
+			} else if (activity.generation() != g0) {
+				// a noted launch ended the park: hits must be
+				// consecutive (a short kernel can post before its note)
+				unseen_run = 0;
+			}
+			continue;
+		}
+		if (B && gate_check(t)) {
+			wfe_wait();
+			st.us_slow_wfe += policy_now_us() - t;
+		} else {
+			sleep_us(P_SLOW);
+			st.slow_sleeps++;
+			st.us_slow += policy_now_us() - t;
+		}
+	}
+	if (fd_la >= 0)
+		close(fd_la);
+	if (fd_sd >= 0)
+		close(fd_sd);
+	if (const char *path = getenv("BPFTIME_CUDA_WATCHER_STATS");
+	    path && *path) {
+		char line[1024];
+		int len = snprintf(
+			line, sizeof(line),
+			"policy=%s pid=%d req=%llu hot_iters=%llu defer_sleeps=%llu slow_sleeps=%llu wfe_waits=%llu parks=%llu park_timeouts=%llu unseen_latch=%llu evq=%llu gate_checks=%llu gate_open_checks=%llu gate_opens=%llu latch_trips=%llu cap_forced=%llu guard_skips=%llu win0=%llu win20=%llu win80=%llu win300=%llu unseen_hits=%llu us_hot=%llu us_defer=%llu us_slow=%llu us_slow_wfe=%llu us_park=%llu late_ewma_us=%.1f\n",
+			policy.c_str(), (int)getpid(),
+			(unsigned long long)st.req,
+			(unsigned long long)st.hot_iters,
+			(unsigned long long)st.defer_sleeps,
+			(unsigned long long)st.slow_sleeps,
+			(unsigned long long)st.wfe_waits,
+			(unsigned long long)st.parks,
+			(unsigned long long)st.park_timeouts,
+			(unsigned long long)st.unseen_latch,
+			(unsigned long long)st.evq,
+			(unsigned long long)st.gate_checks,
+			(unsigned long long)st.gate_open_checks,
+			(unsigned long long)st.gate_opens,
+			(unsigned long long)st.latch_trips,
+			(unsigned long long)st.cap_forced,
+			(unsigned long long)st.guard_skips,
+			(unsigned long long)st.win_hist[0],
+			(unsigned long long)st.win_hist[1],
+			(unsigned long long)st.win_hist[2],
+			(unsigned long long)st.win_hist[3],
+			(unsigned long long)st.unseen_hits,
+			(unsigned long long)st.us_hot,
+			(unsigned long long)st.us_defer,
+			(unsigned long long)st.us_slow,
+			(unsigned long long)st.us_slow_wfe,
+			(unsigned long long)st.us_park, late_ewma);
+		int fd = open(path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC,
+			      0644);
+		if (fd >= 0) {
+			if (len > 0)
+				(void)!write(fd, line, (size_t)len);
+			close(fd);
+		}
+	}
+}
